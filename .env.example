# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXT_PUBLIC_UPLOAD_SERVICE_URL=http://localhost:3005
# Social Authentication
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Email Configuration (SMTP)
# For Gmail: Use App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@prostaspawa.pl"

# Przelewy24 (Payment Gateway)
# P24_MERCHANT_ID="your-merchant-id"
# P24_POS_ID="your-pos-id"
# P24_API_KEY="your-api-key"
# P24_CRC="your-crc"
# P24_MODE="sandbox" # or "production"

# Google Calendar API (for Google Meet links)
# To get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google Calendar API
# 4. Create Service Account credentials
# 5. Download JSON key file
# 6. Copy client_email and private_key from the JSON file
# 7. Set up Domain-Wide Delegation (see docs)
GOOGLE_CLIENT_EMAIL="292006407154-kil4ld7bcirk9pufgfecpbht3kigqq42.apps.googleusercontent.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
# Google Workspace admin email to impersonate for creating calendar events
# This user must have a Google Workspace account with Calendar access
GOOGLE_ADMIN_EMAIL="admin@yourdomain.com"

# Other services
# Add other API keys and configuration here
