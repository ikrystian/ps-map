# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
ENV=dev
DATABASE_URL="file:./prisma/dev.db"
# NextAuth.js
URL=""
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST=
ENCRYPTION_KEY=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Sekret dla zadań CRON (WYMAGANY na produkcji).
# Endpointy /api/cron/* oraz /api/partner-program/allocate-points są zablokowane (503),
# jeśli nie jest ustawiony. Wywołuj je z nagłówkiem: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=w

# Przelewy24
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=
P24_API_URL=

# PayU (Payment Gateway)
 PAYU_POS_ID=""
 PAYU_MD5_KEY=""
 PAYU_CLIENT_ID=""
 PAYU_CLIENT_SECRET=""
 PAYU_ENVIRONMENT="sandbox"


# c15t - Consent Management Platform
# Sign up at https://consent.io to get your project ID
# Or use self-hosted: https://c15t.com/docs/self-host/v2
NEXT_PUBLIC_C15T_PROJECT_ID=
# Optional: Custom API endpoint for self-hosted c15t
# NEXT_PUBLIC_C15T_API_URL=https://your-c15t-instance.com
UPLOADTHING_TOKEN=
PRISMA_CLIENT_ENGINE_TYPE=""

# OpenRouter - klucz API asystenta AI (czat). Pobierz z https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Pexels - klucz API do pobierania zdjęć przy imporcie ekspertów (logo/zdjęcie
# główne/galeria). Darmowy klucz: https://www.pexels.com/api/
PEXELS_API_KEY=""

# Wyszukiwanie danych firmy po NIP przy rejestracji "jako firma".
# Źródło: API "Wykaz podatników VAT" (Biała lista) Ministerstwa Finansów.
# Usługa jest BEZPŁATNA i NIE wymaga klucza — ta zmienna jest opcjonalna i służy
# wyłącznie do nadpisania bazowego adresu (domyślnie https://wl-api.mf.gov.pl).
BIALA_LISTA_URL=""

# Automatyczne backupy bazy danych na Google Drive (wykorzystują GOOGLE_CLIENT_EMAIL i GOOGLE_PRIVATE_KEY)
GOOGLE_DRIVE_FOLDER_ID="1G6d4PNY0V_za37ogt9m2GRlunZuOy0LM" # Opcjonalny ID folderu na Dysku Google (jeśli nie podano, zapisuje w głównym katalogu konta)
BACKUP_KEEP_DAYS="130"     # Retencja backupów lokalnie i na Dysku Google (domyślnie 30 dni)
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET="twój-client-secret"

GOOGLE_CALENDAR_ID=""
