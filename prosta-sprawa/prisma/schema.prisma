// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// UŻYTKOWNICY I AUTORYZACJA
// ============================================================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hash bcrypt (nullable for OAuth)
  role          UserRole  @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  deletedAt     DateTime?  // Soft delete timestamp

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Relacje
  client        Client?
  lawFirm       LawFirm?
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications Notification[]
  notificationSettings NotificationSettings?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  CLIENT      // Klient
  LAW_FIRM    // Kancelaria
  ADMIN       // Administrator
}

enum UserStatus {
  ACTIVE      // Aktywny
  INACTIVE    // Nieaktywny
  SUSPENDED   // Zawieszony
}

// ============================================================================
// KLIENCI
// ============================================================================

model Client {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dane osobowe
  imie            String
  nazwisko        String
  telefon         String?

  // Adres
  adres           String?
  kodPocztowy     String?
  miasto          String?
  voivodeshipId   String?
  voivodeship     Voivodeship? @relation(fields: [voivodeshipId], references: [id])

  // Zgody marketingowe
  zgodaRegulamin  Boolean  @default(false)
  zgodaNewsletter Boolean  @default(false)
  zgodaMarketing  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacje
  cases           Case[]
  reviews         Review[]
  favoritesFirms  FavoriteLawFirm[]
  negotiations    Negotiation[]

  @@index([userId])
  @@index([voivodeshipId])
}

// ============================================================================
// KANCELARIE PRAWNE
// ============================================================================

model LawFirm {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Typ działalności
  typ                   LawFirmType
  typInny               String?  // Jeśli typ = INNY

  // Dane firmy
  nazwa                 String
  nazwaFirmy            String
  nip                   String   @unique
  regon                 String?
  krs                   String?

  // Dane kontaktowe
  imieKontakt           String
  nazwiskoKontakt       String
  stanowisko            String?
  numerTelefonu         String
  numerTelefonu2        String?
  emailKontakt          String

  // Adres siedziby
  adres                 String
  kodPocztowy           String
  miasto                String
  voivodeshipId         String
  voivodeship           Voivodeship @relation(fields: [voivodeshipId], references: [id])

  // Profil publiczny
  opis                  String?   @default("")
  logo                  String?   // URL do logo
  zdjecieGlowne         String?   // URL do zdjęcia głównego
  galeriaZdjec          String?   // JSON array URL-i
  filmYouTube           String?   // URL do filmu
  okladkaFilmu          String?   // URL do miniatury filmu
  kolejnoscMultimedia   String?   @default("zdjecia") // "zdjecia" lub "film"

  // Godziny otwarcia
  statusGodzinyOtwarcia Boolean  @default(false)
  godzinyOtwarcia       String?  // JSON: {"poniedzialek": "9:00-17:00", ...}

  // Social media
  linkLinkedIn          String?
  linkFacebook          String?
  linkInstagram         String?
  linkTwitter           String?
  linkTikTok            String?
  stronaWww             String?

  // Edukacja
  edukacja              String?  // JSON array: [{"uczelnia": "", "wydzial": "", "rokOd": 2000, "rokDo": 2005}, ...]

  // Wpisy do rejestrów
  oirpMiasto            String?
  oirpWpis              String?
  oirpStatus            Boolean  @default(false)
  oraMiasto             String?
  oraWpis               String?
  oraStatus             Boolean  @default(false)

  // Specjalizacje i usługi
  unikatowyOpisUslugi   String?
  slowaKluczowe         String?  // JSON array tagów

  // Obszar działania
  callaPolska           Boolean  @default(false)
  onlineOnly            Boolean  @default(false)

  // Typ oferty
  typOferty             OfferType

  // System punktowy i subskrypcja
  punktySaldo           Int      @default(0)
  pakietSubskrypcji     SubscriptionPackage @default(PODSTAWOWY)
  dataPakietuOd         DateTime?
  dataPakietuDo         DateTime?

  // Statystyki
  wyswietleniaProfilu   Int      @default(0)
  zlozoneOferty         Int      @default(0)
  wygraneOferty         Int      @default(0)
  konwersja             Float    @default(0)
  pozycjaRanking        Int?

  // Zgody
  zgodaRegulamin        Boolean  @default(false)
  zgodaPrzetwarzanie    Boolean  @default(false)

  // Status konta
  zweryfikowana         Boolean  @default(false)
  aktywna               Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  voivodeships          LawFirmVoivodeship[]  // Województwa działania
  categories            LawFirmCategory[]     // Specjalizacje
  services              Service[]
  certificates          Certificate[]
  blogPosts             BlogPost[]
  offers                Offer[]
  reviews               Review[]
  orders                Order[]
  invoices              Invoice[]
  promotions            Promotion[]
  favoritedBy           FavoriteLawFirm[]
  documents             Document[]

  @@index([userId])
  @@index([voivodeshipId])
  @@index([nip])
  @@index([zweryfikowana])
  @@index([aktywna])
}

enum LawFirmType {
  OSOBA_FIZYCZNA
  SPOLKA_CYWILNA
  SPOLKA_PARTNERSKA
  SPOLKA_KOMANDYTOWA
  SPOLKA_JAWNA
  SPOLKA_ZOO
  INNY
}

enum OfferType {
  STALA_WSPOLPRACA
  JEDNORAZOWA_USLUGA
  KONSULTACJA
  WSZYSTKIE
}

enum SubscriptionPackage {
  PODSTAWOWY    // 440 zł/rok
  STANDARD      // 880 zł/rok
  PREMIUM       // 1320 zł/rok
  BIZNES        // 1980 zł/rok
}

// ============================================================================
// RELACJA: KANCELARIA <-> WOJEWÓDZTWA DZIAŁANIA
// ============================================================================

model LawFirmVoivodeship {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id])

  createdAt       DateTime @default(now())

  @@unique([lawFirmId, voivodeshipId])
  @@index([lawFirmId])
  @@index([voivodeshipId])
}

// ============================================================================
// RELACJA: KLIENT <-> ULUBIONE KANCELARIE
// ============================================================================

model FavoriteLawFirm {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([clientId, lawFirmId])
  @@index([clientId])
  @@index([lawFirmId])
}

// ============================================================================
// KATEGORIE PRAWNE (SPECJALIZACJE)
// ============================================================================

enum CategoryType {
  SPRAWY_FIRMOWE   // Business cases
  SPRAWY_PRYWATNE  // Private cases
}

model Category {
  id          String   @id @default(uuid())
  nazwa       String
  slug        String   @unique
  opis        String?
  opisDodatkowy String?  // Additional description
  ikona       String?    // Icon name (e.g., from Lucide)

  // Typ kategorii
  typ         CategoryType @default(SPRAWY_PRYWATNE)

  // Hierarchia (parent/child)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  // SEO
  metaTitle       String?
  metaDescription String?

  aktywna     Boolean  @default(true)
  kolejnosc   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacje
  lawFirms    LawFirmCategory[]
  cases       Case[]

  @@index([slug])
  @@index([parentId])
  @@index([aktywna])
  @@index([typ])
}

// ============================================================================
// RELACJA: KANCELARIA <-> KATEGORIE (MANY-TO-MANY)
// ============================================================================

model LawFirmCategory {
  id          String   @id @default(uuid())
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  kolejnosc   Int      @default(0)  // Order of category for this law firm

  createdAt   DateTime @default(now())

  @@unique([lawFirmId, categoryId])
  @@index([lawFirmId])
  @@index([categoryId])
}

// ============================================================================
// SPRAWY (CASES)
// ============================================================================

model Case {
  id                        String   @id @default(uuid())
  clientId                  String
  client                    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Typ sprawy
  typSprawy                 CaseType

  // Kategoria
  categoryId                String
  category                  Category @relation(fields: [categoryId], references: [id])
  wybranadziedzinaPrawa     String?  // Podkategoria
  wybranaSpecyfikacja       String?  // Szczegółowa specyfikacja
  specjalizacja             String?  // Dodatkowe wymagania

  // Opis sprawy
  nazwaSprawy               String
  opisSprawy                String   // Min 100 znaków
  zalaczniki                String?  // JSON array URL-i (max 5 plików)

  // Termin i budżet
  oczekiwanyTerminRealizacji DateTime?
  trybPilny                 Boolean  @default(false)
  budzetOd                  Float?
  budzetDo                  Float?
  doNegocjacji              Boolean  @default(false)

  // Dane kontaktowe
  imieNazwisko              String
  emailKontakt              String
  telefonKontakt            String
  preferowanyKontakt        PreferredContact

  // Lokalizacja
  voivodeshipId             String
  voivodeship               Voivodeship @relation(fields: [voivodeshipId], references: [id])

  // Status
  status                    CaseStatus @default(NOWA)

  // Archiwizacja (soft delete)
  isArchived                Boolean  @default(false)
  archivedAt                DateTime?

  // Zgody
  akceptujeKlauzule         Boolean  @default(false)

  // Daty
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  zamknieto                 DateTime?

  // Relacje
  offers                    Offer[]
  messages                  Message[]

  @@index([clientId])
  @@index([categoryId])
  @@index([voivodeshipId])
  @@index([status])
  @@index([isArchived])
  @@index([createdAt])
}

enum CaseType {
  OSOBA_PRYWATNA
  FIRMA
  ORGANIZACJA
}

enum CaseStatus {
  NOWA
  OFERTY_OTRZYMANE
  W_TRAKCIE
  ZAKONCZONA
  ANULOWANA
}

enum PreferredContact {
  EMAIL
  TELEFON
  OBA
}

// ============================================================================
// OFERTY (OFFERS)
// ============================================================================

model Offer {
  id                  String   @id @default(uuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawFirmId           String
  lawFirm             LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Wycena
  kwotaNetto          Float
  vat                 Int      // 23, 8, 0, -1 (zwolniony)
  kwotaBrutto         Float

  // Termin
  terminRealizacjiDni Int      // Dni robocze

  // Opis
  opisOferty          String   // Min 200 znaków
  zakresUslug         String

  // Warunki płatności
  warunkiPlatnosci    PaymentTerms
  dodatkoweWarunki    String?

  // Wyróżnienie
  wyroznienie         Boolean  @default(false)
  punktyWyroznienia   Int?

  // Status
  status              OfferStatus @default(ZLOZONA)

  // Daty
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  zaakceptowanaData   DateTime?
  odrzuconaData       DateTime?

  // Relacje
  negotiations        Negotiation[]

  @@index([caseId])
  @@index([lawFirmId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentTerms {
  PRZELEW_7
  PRZELEW_14
  PRZELEW_30
  Z_GORY
  RATY
  INNY
}

enum OfferStatus {
  ZLOZONA
  ZAAKCEPTOWANA
  ODRZUCONA
  NEGOCJACJE
  WYGASLA
}

// ============================================================================
// NEGOCJACJE OFERT
// ============================================================================

model Negotiation {
  id                  String   @id @default(uuid())
  offerId             String
  offer               Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  propozycjaKwoty     Float
  uzasadnienie        String
  terminRealizacji    DateTime?

  createdAt           DateTime @default(now())

  @@index([offerId])
  @@index([clientId])
}

// ============================================================================
// WIADOMOŚCI
// ============================================================================

model Message {
  id            String   @id @default(uuid())
  senderId      String
  sender        User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  // Opcjonalnie powiązana ze sprawą
  caseId        String?
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  temat         String
  tresc         String
  zalaczniki    String?  // JSON array URL-i

  przeczytana   Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([caseId])
  @@index([przeczytana])
  @@index([createdAt])
}

// ============================================================================
// OPINIE (REVIEWS)
// ============================================================================

model Review {
  id                  String   @id @default(uuid())
  lawFirmId           String
  lawFirm             LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Oceny (1-5 gwiazdek)
  ocenaOgolna         Int      // Wymagana
  profesjonalizm      Int?
  komunikacja         Int?
  terminowosc         Int?
  stosunekJakosci     Int?

  // Treść opinii
  tytulOpinii         String
  trescOpinii         String   // Min 50 znaków

  // Opcje
  polecam             Boolean  @default(true)
  anonimowa           Boolean  @default(false)

  // Odpowiedź kancelarii
  odpowiedz           String?
  dataOdpowiedzi      DateTime?

  // Status
  zweryfikowana       Boolean  @default(false)
  aktywna             Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lawFirmId])
  @@index([clientId])
  @@index([createdAt])
  @@index([aktywna])
}

// ============================================================================
// USŁUGI KANCELARII
// ============================================================================

model Service {
  id            String   @id @default(uuid())
  lawFirmId     String
  lawFirm       LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwaUslugi   String
  opisUslugi    String
  cenaOd        Float?
  cenaDo        Float?
  jednostka     ServiceUnit

  aktywna       Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lawFirmId])
  @@index([aktywna])
}

enum ServiceUnit {
  ZA_USLUGE
  ZA_GODZINE
  RYCZALT
  DO_UZGODNIENIA
}

// ============================================================================
// CERTYFIKATY KANCELARII
// ============================================================================

model Certificate {
  id                String   @id @default(uuid())
  lawFirmId         String
  lawFirm           LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwaCertyfikatu  String
  wydawca           String
  dataUzyskania     DateTime
  dataWaznosci      DateTime?
  numerCertyfikatu  String?
  skanCertyfikatu   String   // URL do pliku

  aktywny           Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lawFirmId])
  @@index([aktywny])
}

// ============================================================================
// KATEGORIE BLOGA
// ============================================================================

model BlogCategory {
  id          String   @id @default(uuid())
  nazwa       String   @unique
  slug        String   @unique
  opis        String?

  aktywna     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacje
  blogPosts   BlogPost[]

  @@index([slug])
  @@index([aktywna])
}

// ============================================================================
// BLOG KANCELARII
// ============================================================================

model BlogPost {
  id                    String   @id @default(uuid())
  lawFirmId             String
  lawFirm               LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  tytul                 String
  slug                  String   @unique
  tresc                 String

  // Kategoria bloga
  categoryId            String?
  category              BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tagi                  String?  // JSON array tagów
  obrazekWyrozniajacy   String?  // URL

  // SEO
  metaTitle             String?
  metaDescription       String?

  opublikowany          Boolean  @default(false)
  dataPublikacji        DateTime?

  wyswietlenia          Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  comments              BlogComment[]

  @@index([lawFirmId])
  @@index([categoryId])
  @@index([slug])
  @@index([opublikowany])
}

// ============================================================================
// KOMENTARZE DO BLOGA
// ============================================================================

model BlogComment {
  id          String   @id @default(uuid())
  blogPostId  String
  blogPost    BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  // Autor (może być niezalogowany)
  userId      String?
  author      String   // Imię
  email       String
  url         String?

  comment     String

  zatwierdzony Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([blogPostId])
  @@index([zatwierdzony])
}

// ============================================================================
// ZAMÓWIENIA PUNKTÓW
// ============================================================================

model Order {
  id                String   @id @default(uuid())
  orderNumber       String?  @unique
  lawFirmId         String
  lawFirm           LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Typ zamówienia
  orderType         OrderType @default(POINTS)

  // Dla zamówień punktów
  pakietPunktow     String?   // "100_pkt", "250_pkt", etc.
  liczbaPunktow     Int?

  // Dla zamówień subskrypcji
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPeriod Int?      // 1, 6, 12 miesięcy
  packageStartDate   DateTime?
  packageEndDate     DateTime?

  // Wspólne pola
  kwota             Float

  metodaPlatnosci   PaymentMethod
  statusPlatnosci   PaymentStatus @default(OCZEKUJE)

  // Dane rozliczeniowe
  daneFaktury       String?  // JSON z danymi do faktury

  // PayU/Przelewy24 integration
  externalOrderId   String?
  transactionId     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  zaplaconoData     DateTime?

  // Relacja z fakturą
  invoice           Invoice?

  @@index([lawFirmId])
  @@index([orderNumber])
  @@index([statusPlatnosci])
  @@index([createdAt])
}

enum OrderType {
  POINTS        // Zakup punktów
  SUBSCRIPTION  // Zakup subskrypcji
}

enum PaymentMethod {
  PAYU
  PRZELEWY24
  PRZELEW
  PAYPAL
  BACS
}

enum PaymentStatus {
  OCZEKUJE
  ZAPLACONE
  ANULOWANE
  ZWROT
}

// ============================================================================
// PROMOCJE
// ============================================================================

model Promotion {
  id                      String   @id @default(uuid())
  lawFirmId               String
  lawFirm                 LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  typPromocji             PromotionType
  czasTrwaniaDni          Int
  kategoriaPromocji       String?
  wojewodztwoPromocji     String?

  startPromocji           DateTime
  koniecPromocji          DateTime

  kosztPunktow            Int
  automatyczneOdnowienie  Boolean  @default(false)

  aktywna                 Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([lawFirmId])
  @@index([aktywna])
  @@index([startPromocji])
  @@index([koniecPromocji])
}

enum PromotionType {
  PODBICIE_OGLOSZENIA     // 20 pkt/dobę
  WYROZNIENIE             // 50 pkt/tydzień
  TOP_LISTA               // 100 pkt/tydzień
  STRONA_GLOWNA           // 200 pkt/tydzień
}

// ============================================================================
// KONFIGURACJA TYPÓW PROMOCJI (ZARZĄDZANE PRZEZ ADMINA)
// ============================================================================

model PromotionConfig {
  id                String   @id @default(uuid())

  // Typ promocji
  type              PromotionType @unique
  label             String
  description       String

  // Koszt
  pointsPerDay      Int?     // Dla promocji rozliczanych dziennie
  pointsPerWeek     Int?     // Dla promocji rozliczanych tygodniowo

  // Cechy/Features (JSON array stringów)
  features          String   // JSON: ["Feature 1", "Feature 2", ...]

  // Ikona i wygląd
  icon              String?  // Nazwa ikony lub URL
  color             String?  // Kolor tła ikony (hex)

  // Status
  aktywna           Boolean  @default(true)
  kolejnosc         Int      @default(0)  // Kolejność wyświetlania

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([aktywna])
  @@index([kolejnosc])
}

// ============================================================================
// POWIADOMIENIA
// ============================================================================

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  typ           NotificationType
  tytul         String
  tresc         String
  linkUrl       String?

  przeczytane   Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([przeczytane])
  @@index([createdAt])
}

enum NotificationType {
  NOWA_OFERTA
  NOWA_WIADOMOSC
  ZMIANA_STATUSU
  NOWA_OPINIA
  MALY_STAN_PUNKTOW
  KONIEC_SUBSKRYPCJI
  SYSTEM
}

// ============================================================================
// USTAWIENIA POWIADOMIEŃ
// ============================================================================

model NotificationSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stare pola (backward compatibility)
  emailNoweOferty   Boolean  @default(true)
  emailWiadomosci   Boolean  @default(true)
  emailStatusy      Boolean  @default(true)
  smsPilne          Boolean  @default(false)

  // Powiadomienia e-mail
  kontaktKlienci              Boolean  @default(true)  // Obowiązkowe
  kluczowe                    Boolean  @default(true)  // Obowiązkowe
  wskazowkiPorady             Boolean  @default(true)
  ofertPromocje               Boolean  @default(true)
  przypomnienieWiadomosci     Boolean  @default(true)
  noweFunkcje                 Boolean  @default(true)
  zmianyCenniki               Boolean  @default(true)
  zmianyRegulamin             Boolean  @default(true)

  // Kontakt telefoniczny
  kontaktDoradca              Boolean  @default(false)

  // Dodatkowe
  wyswietlanieAwatara         Boolean  @default(true)
  autoProsbOpinie             Boolean  @default(false)
  powiadomienieDzwiekowe      Boolean  @default(false)

  // Ustawienia ogłoszenia
  ustawieniaOgloszenia        Boolean  @default(true)

  // Dodatkowe ustawienia powiadomień dla ogłoszeń
  powiadomieniaSmNowa         Boolean  @default(false)  // SMS przy nowej wiadomości
  wiadomosciZbiorcze          Boolean  @default(true)   // E-mail - wiadomości zbiorcze
  urlop                       Boolean  @default(false)  // Tryb urlopowy

  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// WOJEWÓDZTWA (SŁOWNIK)
// ============================================================================

model Voivodeship {
  id              String   @id @default(uuid())
  nazwa           String   @unique
  slug            String   @unique

  // Relacje
  cities          City[]
  clients         Client[]
  lawFirms        LawFirm[]
  lawFirmVoivodeships LawFirmVoivodeship[]
  cases           Case[]

  @@index([slug])
}

// ============================================================================
// MIASTA (SŁOWNIK)
// ============================================================================

model City {
  id              String   @id @default(uuid())
  nazwa           String
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id])

  @@index([voivodeshipId])
  @@index([nazwa])
}

// ============================================================================
// NEWSLETTER
// ============================================================================

model Newsletter {
  id            String   @id @default(uuid())
  email         String   @unique
  imie          String?
  zgoda         Boolean  @default(true)
  aktywny       Boolean  @default(true)

  dataZapisu    DateTime @default(now())
  dataRezygnacji DateTime?

  @@index([email])
  @@index([aktywny])
}

// ============================================================================
// PAKIETY SUBSKRYPCJI
// ============================================================================

model SubscriptionPlan {
  id                    String   @id @default(uuid())

  // Podstawowe informacje
  typ                   SubscriptionPackage @unique
  nazwa                 String
  cena1Miesiac          Float?
  cena6Miesiecy         Float?
  cena12Miesiecy        Float
  aktywny               Boolean  @default(true)

  // Dostęp do spraw
  dostepDoSpraw         Int?     // null = nieograniczone

  // Kategorie i lokalizacje
  kategorieSpraw        Int?     // null = nieograniczone
  wojewodztwa           Int
  miasta                Int

  // Funkcjonalności
  priorytetWyszukiwanie Boolean  @default(false)
  osobistyOpiekun       Int      @default(0)
  artykutySponsoro      Boolean  @default(false)
  specjalneOznaczenie   String?  // null, "Podstawowe", "Rozszerzone"
  statystykiAnalizy     Boolean  @default(false)
  mozliwoscBloga        Boolean  @default(false)
  wsparcieMarketingowe  Boolean  @default(false)
  promowanieProfilu     Boolean  @default(false)

  // Powiadomienia i komunikacja
  powiadomieniaSprawy   Int      @default(0)
  liczbaTakow           Int      @default(0)
  zalaczniki            Boolean  @default(false)
  coverBaner            Boolean  @default(false)
  wyswietlanieReklam    Boolean  @default(true)

  // Punkty gratis
  punktyGratis          Int      @default(0)

  // Skill Law Focus - specjalna funkcjonalność (dla pakietu BIZNES)
  skillLawFocus         Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  orders                Order[]

  @@index([typ])
  @@index([aktywny])
}

// ============================================================================
// FAKTURY VAT
// ============================================================================

model Invoice {
  id                    String   @id @default(uuid())
  invoiceNumber         String   @unique

  // Relacje
  orderId               String   @unique
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lawFirmId             String
  lawFirm               LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Dane nabywcy (zapisane na moment wystawienia faktury)
  buyerName             String
  buyerNIP              String?
  buyerAddress          String
  buyerPostalCode       String
  buyerCity             String
  buyerCountry          String   @default("Polska")

  // Kwoty
  netAmount             Float    // Kwota netto
  vatRate               Float    @default(23.0) // Stawka VAT w %
  vatAmount             Float    // Kwota VAT
  grossAmount           Float    // Kwota brutto

  // Status i daty
  status                InvoiceStatus @default(ISSUED)
  issueDate             DateTime @default(now())
  saleDate              DateTime @default(now())
  paymentDate           DateTime?
  dueDate               DateTime

  // PDF
  pdfUrl                String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([lawFirmId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
}

enum InvoiceStatus {
  DRAFT         // Szkic
  ISSUED        // Wystawiona
  SENT          // Wysłana
  PAID          // Opłacona
  CANCELLED     // Anulowana
}

// ============================================================================
// FORMULARZ KONTAKTOWY
// ============================================================================

model ContactForm {
  id            String   @id @default(uuid())
  imieNazwisko  String
  email         String
  telefon       String?
  temat         ContactSubject
  wiadomosc     String
  zalacznik     String?  // URL do załącznika

  odpowiedziano Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([odpowiedziano])
  @@index([createdAt])
}

enum ContactSubject {
  INFORMACJA
  WSPARCIE
  WSPOLPRACA
  REKLAMACJA
  INNE
}

// ============================================================================
// CENTRUM POMOCY
// ============================================================================

model HelpCategory {
  id          String   @id @default(uuid())
  nazwa       String
  slug        String   @unique
  opis        String?
  ikona       String?  // Nazwa ikony z Lucide
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)

  // Relacje
  questions   HelpQuestion[]
}

// ============================================================================
// MODUŁY I STRONY
// ============================================================================

model Module {
  id          String     @id @default(uuid())
  name        String     // Nazwa modułu
  code        String     // Kod HTML z tagami specjalnymi jak {input-text}, {textarea-wysiwyg}, etc. lub czysty HTML dla EDITABLE_HTML
  description String?    // Opcjonalny opis modułu
  preview     String?    // URL do zdjęcia podglądu modułu
  type        ModuleType @default(TEMPLATE) // Typ modułu: TEMPLATE (z polami) lub EDITABLE_HTML (edytowalny HTML)

  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relacje
  pageModules PageModule[]

  @@index([active])
  @@index([createdAt])
  @@index([type])
}

enum ModuleType {
  TEMPLATE      // Moduł z polami edytowalnymi (stary system z {input-text}, etc.)
  EDITABLE_HTML // Moduł z edytowalnym HTML (nowy system z contenteditable)
}

model HelpQuestion {
  id          String   @id @default(uuid())
  categoryId  String
  category    HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pytanie     String
  odpowiedz   String   // Treść w markdown/HTML
  slug        String   @unique
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)

  // Statystyki
  wyswietlenia Int     @default(0)
  pomocne     Int      @default(0)
  niepomocne  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([aktywna])
  @@index([kolejnosc])
}

// ============================================================================
// DOKUMENTY KANCELARII
// ============================================================================

model Document {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwa           String
  typDokumentu    String   // np. "umowa", "regulamin", "wzór pisma", etc.
  rozmiar         Int      // Rozmiar w bajtach
  sciezka         String   // Ścieżka do pliku
  rozszerzenie    String   // np. "pdf", "docx", "txt"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([createdAt])
  @@index([typDokumentu])
}

model Page {
  id              String   @id @default(uuid())
  title           String   // Tytuł strony
  slug            String   @unique // URL-friendly slug

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status publikacji
  published       Boolean  @default(false)
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacje
  modules         PageModule[]

  @@index([slug])
  @@index([published])
  @@index([createdAt])
}

model PageModule {
  id        String   @id @default(uuid())

  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  order     Int      // Kolejność modułu na stronie
  data      String?  // JSON z danymi wypełnionymi przez użytkownika

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, moduleId, order])
  @@index([pageId])
  @@index([moduleId])
  @@index([order])
}
