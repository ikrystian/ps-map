## Modele danych

### Model: Offer

**Plik:** `/prosta-sprawa/prisma/schema.prisma`

```prisma
model Offer {
  id                    String    @id @default(uuid())
  caseId                String
  lawFirmId             String

  // Wycena
  kwotaNetto            Decimal   @db.Decimal(10, 2)
  vat                   Int       // Stawka VAT: 0, 8, 23 lub -1 (zwolniony)
  kwotaBrutto           Decimal   @db.Decimal(10, 2)

  // Warunki
  terminRealizacjiDni   Int       // Dni robocze
  warunkiPlatnosci      String    // Enum: PRZELEW_7, PRZELEW_14, PRZELEW_30, Z_GORY, RATY, INNY

  // Treść
  opisOferty            String    @db.Text
  zakresUslug           String    @db.Text
  dodatkoweWarunki      String?   @db.Text

  // Promowanie
  wyroznienie           Boolean   @default(false)
  punktyWyroznienia     Int?

  // Status
  status                OfferStatus @default(ZLOZONA)
  zaakceptowanaData     DateTime?
  odrzuconaData         DateTime?

  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relacje
  case                  Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawFirm               LawFirm   @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  negotiations          Negotiation[]

  // Indeksy
  @@index([caseId])
  @@index([lawFirmId])
  @@index([status])
  @@index([createdAt])
  @@unique([caseId, lawFirmId]) // Jedna oferta na kancelarię-sprawę
}

enum OfferStatus {
  ZLOZONA          // Oferta złożona, czeka na decyzję
  ZAAKCEPTOWANA    // Zaakceptowana przez klienta
  ODRZUCONA        // Odrzucona przez klienta lub auto-odrzucona
  NEGOCJACJE       // W trakcie negocjacji
  WYGASLA          // Wygasła (po 30 dniach)
}
```

### Model: Case (fragment związany z ofertami)

```prisma
model Case {
  id                    String    @id @default(uuid())
  clientId              String
  categoryId            String

  nazwaSprawy           String
  opisSprawy            String    @db.Text

  budzetOd              Decimal?  @db.Decimal(10, 2)
  budzetDo              Decimal?  @db.Decimal(10, 2)
  oczekiwanyTerminRealizacji String?

  status                CaseStatus @default(NOWA)

  // Relacje
  offers                Offer[]
  // ... inne relacje

  @@index([status])
}

enum CaseStatus {
  NOWA                 // Sprawa nowa
  OFERTY_OTRZYMANE     // Otrzymano co najmniej jedną ofertę
  W_TRAKCIE            // Zaakceptowano ofertę, sprawa w realizacji
  ZAMKNIETA            // Sprawa zakończona
  ANULOWANA            // Sprawa anulowana przez klienta
}
```

### Model: LawFirm (fragment związany z ofertami)

```prisma
model LawFirm {
  id                    String    @id @default(uuid())
  userId                String    @unique
  nazwa                 String
  slug                  String    @unique

  // Statystyki
  zlozoneOferty         Int       @default(0)
  wygraneOferty         Int       @default(0)
  konwersja             Decimal?  @db.Decimal(5, 2) // Procent: 0.00-100.00
  punktySaldo           Int       @default(0)

  // Relacje
  offers                Offer[]
  stats                 LawFirmStats[]
  categoryStats         LawFirmCategoryStats[]
  // ... inne relacje
}
```

### Model: LawFirmStats (statystyki miesięczne)

```prisma
model LawFirmStats {
  id                    String    @id @default(uuid())
  lawFirmId             String
  year                  Int
  month                 Int       // 1-12

  offersSubmitted       Int       @default(0)
  offersAccepted        Int       @default(0)
  offersRejected        Int       @default(0)

  lawFirm               LawFirm   @relation(fields: [lawFirmId], references: [id])

  @@unique([lawFirmId, year, month])
  @@index([lawFirmId])
}
```

### Model: LawFirmCategoryStats (statystyki per kategoria)

```prisma
model LawFirmCategoryStats {
  id                    String    @id @default(uuid())
  lawFirmId             String
  categoryId            String

  offersSubmitted       Int       @default(0)
  offersAccepted        Int       @default(0)

  lawFirm               LawFirm   @relation(fields: [lawFirmId], references: [id])
  category              Category  @relation(fields: [categoryId], references: [id])

  @@unique([lawFirmId, categoryId])
}
```

### Model: Notification

```prisma
model Notification {
  id                    String    @id @default(uuid())
  userId                String
  typ                   String    // NOWA_OFERTA, ZMIANA_STATUSU, etc.
  tytul                 String
  tresc                 String    @db.Text
  linkUrl               String?
  przeczytane           Boolean   @default(false)
  createdAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id])

  @@index([userId, przeczytane])
  @@index([createdAt])
}
```

### TypeScript Types

**Plik:** `/prosta-sprawa/types/offers.ts`

```typescript
/**
 * Base offer type
 */
export interface OfferBase {
  id: string
  kwotaNetto: number
  vat: number
  kwotaBrutto: number
  terminRealizacjiDni: number
  opisOferty: string
  zakresUslug: string
  warunkiPlatnosci: string
  dodatkoweWarunki?: string | null
  wyroznienie: boolean
  status: string
  createdAt: string | Date
}

/**
 * Offer with case information (for client view)
 */
export interface OfferWithCase extends OfferBase {
  case: {
    id: string
    nazwaSprawy: string
    status: string
    category: CategoryReference
  }
  lawFirm: LawFirmReference & {
    miasto: string
    voivodeship: {
      nazwa: string
    }
  }
}

/**
 * Offers response with pagination
 */
export interface OffersResponse {
  offers: OfferWithCase[]
  pagination: {
    page: number
    limit: number
    total: number
    totalPages: number
  }
}
```

