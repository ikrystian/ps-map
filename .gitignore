# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/.next-old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
server.log
npm_output.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/app/generated/prisma
*.db
*.db-journal
.uploads/
# Pliki zleceń zastępstw (tajemnica zawodowa) — serwowane tylko przez /api/substitutions/[id]/files
.substitutions/
.invoices/
files/
public/uploads/
.uploads
files/
.understand-anything
# database backups
/backups/

# Sentry Config File
.env.sentry-build-plugin
dev.db-shm
dev.db-wal

# ekspert-spa (Vite + Capacitor) — Tailwind v4 skanuje wszystko, czego nie ma w .gitignore,
# a korzeniowe /node_modules nie obejmuje zagnieżdżonego katalogu
/ekspert-spa/node_modules/
/ekspert-spa/dist/
/ekspert-spa/android/.gradle/
/ekspert-spa/android/build/
/ekspert-spa/android/app/build/
/ekspert-spa/android/app/src/main/assets/public/
/ekspert-spa/ios/App/App/public/
/ekspert-spa/ios/App/build/
/ekspert-spa/ios/DerivedData/
