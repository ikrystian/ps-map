// ============================================================================
// DOKUMENTY KANCELARII
// ============================================================================

model Document {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwa           String
  typDokumentu    String   // np. "umowa", "regulamin", "wzór pisma", etc.
  rozmiar         Int      // Rozmiar w bajtach
  sciezka         String   // Ścieżka do pliku
  rozszerzenie    String   // np. "pdf", "docx", "txt"

  // Opcjonalne: jeśli dokument pochodzi od klienta
  zrodlo          String   @default("KANCELARIA") // "KANCELARIA" lub "KLIENT"
  clientUserId    String?  // ID klienta, który wysłał plik
  clientUser      User?    @relation("ClientDocuments", fields: [clientUserId], references: [id], onDelete: Cascade)
  conversationId  String?  // ID konwersacji, w której wysłano plik
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([createdAt])
  @@index([typDokumentu])
  @@index([zrodlo])
  @@index([clientUserId])
  @@index([conversationId])
}

model Page {
  id              String   @id @default(uuid())
  title           String   // Tytuł strony
  slug            String   @unique // URL-friendly slug

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status publikacji
  published       Boolean  @default(false)
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacje
  modules         PageModule[]

  @@index([slug])
  @@index([published])
  @@index([createdAt])
}

model PageModule {
  id        String   @id @default(uuid())

  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  order     Int      // Kolejność modułu na stronie
  data      String?  // JSON z danymi wypełnionymi przez użytkownika

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, moduleId, order])
  @@index([pageId])
  @@index([moduleId])
  @@index([order])
}

// ============================================================================
// USTAWIENIA SYSTEMU
// ============================================================================

model Settings {
  id                        String   @id @default(uuid())
  key                       String   @unique
  value                     String
  description               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// HISTORIA LOGOWAŃ
// ============================================================================

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  success     Boolean  @default(true)  // true = udane, false = nieudane
  ipAddress   String?
  userAgent   String?
  location    String?  // Opcjonalna lokalizacja (miasto, kraj)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([success])
}

// ============================================================================
// LOGI SYSTEMOWE
// ============================================================================

model SystemLog {
  id          String      @id @default(uuid())
  level       LogLevel    @default(INFO)
  action      String      // Rodzaj akcji (np. "USER_LOGIN", "ORDER_CREATED", "PAYMENT_STATUS_CHANGED")
  message     String      // Opis zdarzenia
  userId      String?     // ID użytkownika, który wykonał akcję (opcjonalne)
  metadata    String?     // Dodatkowe dane w formacie JSON
  ipAddress   String?     // Adres IP użytkownika
  userAgent   String?     // User agent przeglądarki
  createdAt   DateTime    @default(now())

  @@index([level])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// AUDYT REJESTRACJI I ZGÓD RODO (art. 5 ust. 2 RODO — rozliczalność)
// ============================================================================

model RegistrationAuditLog {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  role                UserRole

  // Zgody RODO / Regulamin
  zgodaRegulamin      Boolean   @default(false)
  zgodaNewsletter     Boolean   @default(false)
  zgodaMarketing      Boolean   @default(false)
  zgodaPrzetwarzanie  Boolean   @default(false)

  // Dane sieciowe i nagłówki HTTP
  ipAddress           String?
  userAgent           String?
  acceptLanguage      String?
  referer             String?
  secChUa             String?
  secChUaPlatform     String?
  secChUaMobile       String?

  // Wykryte/parsowane środowisko użytkownika
  browser             String?   // np. "Chrome", "Firefox", "Safari"
  browserVersion      String?   // np. "120.0.0.0"
  os                  String?   // np. "Windows", "macOS", "Android", "iOS", "Linux"
  osVersion           String?   // np. "10", "14.1"
  deviceType          String?   // "Desktop", "Mobile", "Tablet"

  // Metadane klienta (zmienne z przeglądarki pobrane przez JS)
  screenResolution    String?   // np. "1920x1080 (24-bit)"
  viewportSize        String?   // np. "1440x900"
  devicePixelRatio    Float?    // np. 1.25, 2
  language            String?   // np. "pl-PL"
  languages           String?   // np. "pl-PL, pl, en-US, en"
  timezone            String?   // np. "Europe/Warsaw"
  timezoneOffset      Int?      // np. -120 (minuty różnicy od UTC)
  platform            String?   // np. "Linux x86_64", "Win32"
  hardwareConcurrency Int?      // np. 8 (liczba rdzeni procesora)
  deviceMemory        Float?    // np. 8 (szacowana pamięć RAM w GB)
  touchSupport        Boolean   @default(false)
  cookieEnabled       Boolean   @default(true)
  doNotTrack          String?   // np. "1", "0", "unspecified"
  onlineStatus        Boolean   @default(true)
  connectionType      String?

  // Skąd trafił użytkownik (URL rejestracji i kampania)
  registrationUrl     String?
  documentReferrer    String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmTerm             String?
  utmContent          String?

  // Kompletne surowe dane w JSON (pewna rozliczalność w przypadku kontroli UODO)
  rawMetadata         String?

  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([role])
}

enum LogLevel {
  DEBUG       // Szczegółowe informacje diagnostyczne
  INFO        // Informacje o normalnym działaniu
  WARNING     // Ostrzeżenia, które nie są błędami
  ERROR       // Błędy, które nie zatrzymują działania systemu
  CRITICAL    // Krytyczne błędy wymagające natychmiastowej uwagi
}

// ============================================================================
// PROGRAM PARTNERSKI
// ============================================================================

model PartnerProgram {
  id                      String   @id @default(uuid())
  lawFirmId               String   @unique
  lawFirm                 LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Informacje o bannerze
  bannerCode              String   @unique // Unikalny kod do weryfikacji obecności bannera
  bannerPlaced            Boolean  @default(false) // Czy banner jest umieszczony
  lastVerificationDate    DateTime? // Data ostatniej weryfikacji
  lastVerificationStatus  Boolean  @default(false) // Status ostatniej weryfikacji
  verificationFailCount   Int      @default(0) // Licznik nieudanych weryfikacji

  // Status programu
  active                  Boolean  @default(true)
  monthlyPoints           Int      @default(100) // Punkty przyznawane miesięcznie

  // Daty
  joinedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relacje
  pointsHistory           PartnerPointsHistory[]

  @@index([lawFirmId])
  @@index([active])
  @@index([bannerCode])
}

model PartnerPointsHistory {
  id                    String   @id @default(uuid())
  partnerProgramId      String
  partnerProgram        PartnerProgram @relation(fields: [partnerProgramId], references: [id], onDelete: Cascade)

  // Przyznane punkty
  pointsAwarded         Int
  month                 Int      // 1-12
  year                  Int

  // Weryfikacja
  verificationUrl       String?  // URL gdzie banner został zweryfikowany
  verificationStatus    Boolean  @default(true)

  createdAt             DateTime @default(now())

  @@unique([partnerProgramId, year, month])
  @@index([partnerProgramId])
  @@index([year, month])
}

// ============================================================================
// OPIEKUNOWIE KANCELARII (ACCOUNT MANAGERS)
