  nazwa           String   @unique
  slug            String   @unique

  // Relacje
  cities          City[]
  clients         Client[]
  lawFirms        LawFirm[]
  lawFirmVoivodeships LawFirmVoivodeship[]
  cases           Case[]

  @@index([slug])
