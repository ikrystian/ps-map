// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// ============================================================================
// UŻYTKOWNICY I AUTORYZACJA
// ============================================================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hash bcrypt (nullable for OAuth)
  role          UserRole  @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  deletedAt     DateTime?  // Soft delete timestamp

  // Dane osobowe / kontaktowe (przeniesione z LawFirm)
  imie          String?
  nazwisko      String?
  numerTelefonu String?
  numerTelefonu2 String?
  // Data potwierdzenia numeru głównego kodem SMS (weryfikacja przy rejestracji).
  // null = numer niezweryfikowany (np. konta założone przed wdrożeniem weryfikacji).
  telefonZweryfikowany DateTime?

  // Adres (przeniesiony z LawFirm)
  adres         String?
  kodPocztowy   String?
  miasto        String?
  voivodeshipId String?
  voivodeship   Voivodeship? @relation(fields: [voivodeshipId], references: [id])
  latitude      Float?     // Współrzędne geograficzne dla mapy
  longitude     Float?     // Współrzędne geograficzne dla mapy

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Relacje
  client        Client?
  lawFirm       LawFirm?
  companyData   CompanyData?  // Dane firmy pobrane z CEIDG DataStore (przedrostek COMPANY_)
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications Notification[]
  notificationSettings NotificationSettings?
  loginHistory  LoginHistory[]

  // Chat relations
  clientConversations     Conversation[] @relation("ClientConversations")
  lawFirmConversations    Conversation[] @relation("LawFirmConversations")
  sentChatMessages        ChatMessage[]  @relation("SentChatMessages")

  // Document relations
  uploadedDocuments       Document[]     @relation("ClientDocuments")

  // Zgłoszenia opinii
  reviewReports       ReviewReport[]

  // Zgłoszenia błędów (ekspert)
  bugReports          BugReport[]

  // Kody OTP przy dodawaniu sprawy
  caseOtpVerifications CaseOtpVerification[]

  // Rejestr anonimizacji konta (RODO art. 17)
  accountDeletion AccountDeletion?

  // Rejestr audytu rejestracji i zgód RODO (RODO art. 5 ust. 2 - rozliczalność)
  registrationAudit RegistrationAuditLog?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([voivodeshipId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Jednorazowy kod (OTP) wysyłany mailem do klienta w celu dodatkowej weryfikacji
// przed utworzeniem sprawy (opcja włączana w ustawieniach panelu administratora, patrz Settings.key = "caseCreationOtpEnabled")
model CaseOtpVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Jednorazowy kod (OTP) wysyłany SMS-em w celu weryfikacji numeru telefonu
// PRZED utworzeniem konta (rejestracja klienta i eksperta). Nie ma tu relacji do
// User — na tym etapie użytkownik jeszcze nie istnieje, kluczem jest sam numer
// w formacie E.164. Po poprawnym kodzie rekord dostaje `token`, który formularz
// dołącza do właściwego requestu rejestracji; endpoint rejestracji go konsumuje.
model PhoneVerification {
  id         String    @id @default(uuid())
  phone      String    // Numer w formacie E.164, np. +48790466488
  code       String
  token      String?   @unique // Wydawany dopiero po poprawnym wpisaniu kodu
  expiresAt  DateTime
  verifiedAt DateTime?
  consumed   Boolean   @default(false) // true = token wykorzystany przy rejestracji
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ============================================================================
// REJESTR ANONIMIZACJI KONT (RODO art. 17 — "prawo do bycia zapomnianym")
// ----------------------------------------------------------------------------
// Konto użytkownika NIE jest kasowane z bazy — rekord User zostaje, ale wszystkie
// dane osobowe są nadpisywane wartościami anonimowymi. Powód: część danych musi
// zostać zachowana na podstawie przepisów prawa (art. 17 ust. 3 lit. b i e RODO):
//   • faktury i dowody księgowe — art. 74 ust. 2 pkt 4 ustawy o rachunkowości
//     oraz art. 86 § 1 Ordynacji podatkowej (5 lat od końca roku obrotowego),
//   • dane nabywcy na fakturze — art. 106e ust. 1 pkt 3-5 ustawy o VAT,
//   • dokumentacja transakcji i korespondencja — do upływu terminu przedawnienia
//     roszczeń (art. 118 Kodeksu cywilnego).
// Ten rekord dokumentuje operację (zasada rozliczalności — art. 5 ust. 2 RODO)
// oraz wyznacza datę, po której zadanie cykliczne "account-retention-purge"
// anonimizuje również dane zatrzymane na podstawie przepisów prawa.
// ============================================================================

model AccountDeletion {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rola konta w chwili anonimizacji (User.role pozostaje niezmieniony)
  role   UserRole

  // SHA-256 z oryginalnego adresu e-mail — pozwala zweryfikować, że dla danego
  // adresu żądanie usunięcia zostało zrealizowane, bez przechowywania adresu.
  emailHash String

  // Kto zainicjował usunięcie: "SELF" (użytkownik) lub "ADMIN"
  requestedBy       String
  requestedByUserId String?
  reason            String?

  // Data, do której przechowywane są dane wymagane przepisami prawa
  retentionUntil DateTime
  // JSON: [{ "model": "Invoice", "count": 3, "basis": "art. 74 ust. 2 ..." }]
  legalBasis     String
  // JSON: podsumowanie ilościowe wykonanych operacji (audyt)
  report         String

  anonymizedAt DateTime  @default(now())
  // Wypełniane przez zadanie czyszczące po upływie okresu retencji
  purgedAt     DateTime?
  purgeReport  String?

  createdAt DateTime @default(now())

  @@index([retentionUntil])
  @@index([purgedAt])
  @@index([emailHash])
  @@index([anonymizedAt])
}

enum UserRole {
  CLIENT      // Klient
  LAW_FIRM    // Ekspert
  ADMIN       // Administrator
}

enum UserStatus {
  ACTIVE      // Aktywny
  INACTIVE    // Nieaktywny
  SUSPENDED   // Zawieszony
  BLOCKED     // Zablokowany
  PENDING     // Oczekuje na zatwierdzenie
}

enum ClientType {
  INDIVIDUAL  // Osoba prywatna
  BUSINESS    // Firma / Organizacja
}

// ============================================================================
// KLIENCI
// ============================================================================

model Client {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Typ klienta
  clientType      ClientType @default(INDIVIDUAL)

  // Dane osobowe / reprezentanta
  imie            String
  nazwisko        String

  // Telefon i adres przeniesione do modelu User
  // (numerTelefonu, adres, kodPocztowy, miasto, voivodeshipId)

  // Dane firmowe (tylko dla BUSINESS)
  nazwa      String?
  nip             String?
  regon           String?
  krs             String?

  // Zgody marketingowe
  zgodaRegulamin  Boolean  @default(false)
  zgodaNewsletter Boolean  @default(false)
  zgodaMarketing  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacje
  cases           Case[]
  reviews         Review[]
  favoritesFirms  FavoriteLawFirm[]
  negotiations    Negotiation[]
  punktySaldo     Int      @default(0)
  consultationBookings ConsultationBooking[]

  @@index([userId])
}

// ============================================================================
// KANCELARIE PRAWNE
// ============================================================================

model LawFirm {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Forma prawna działalności. Nullable, bo rejestracja jej nie zbiera —
  // null oznacza „nieokreślona”, a nie „inna”. Specjalizacja eksperta to
  // osobna rzecz: trzyma ją `expertiseCategoryId` (ścieżkę wyliczamy z drzewa).
  typ                   LawFirmType?
  typInny               String?  // Doprecyzowanie formy prawnej, gdy typ = INNY

  // Dane firmy
  nazwa                 String
  slug                  String   @unique // URL-friendly slug
  nip                   String?  @unique
  regon                 String?
  krs                   String?

  // Dane kontaktowe i adres siedziby przeniesione do modelu User
  // (imie, nazwisko, numerTelefonu, numerTelefonu2, adres, kodPocztowy,
  //  miasto, voivodeshipId, latitude, longitude)

  // Profil publiczny
  opis                  String?   @default("")
  logo                  String?   // URL do logo
  zdjecieGlowne         String?   // URL do zdjęcia głównego
  galeriaZdjec          String?   // JSON array URL-i
  filmYouTube           String?   // URL do filmu
  okladkaFilmu          String?   // URL do miniatury filmu
  kolejnoscMultimedia   String?   @default("zdjecia") // "zdjecia" lub "film"

  // Godziny otwarcia
  statusGodzinyOtwarcia Boolean  @default(false)
  godzinyOtwarcia       String?  // JSON: {"poniedzialek": "9:00-17:00", ...}

  // Social media
  linkLinkedIn          String?
  linkFacebook          String?
  linkInstagram         String?
  linkTwitter           String?
  linkTikTok            String?
  stronaWww             String?

  // Edukacja
  edukacja              String?  // JSON array: [{"uczelnia": "", "wydzial": "", "rokOd": 2000, "rokDo": 2005}, ...]

  // Wpisy do rejestrów
  oirpMiasto            String?
  oirpWpis              String?
  oirpStatus            Boolean  @default(false)
  oraMiasto             String?
  oraWpis               String?
  oraStatus             Boolean  @default(false)

  // Specjalizacje i usługi
  unikatowyOpisUslugi   String?
  slowaKluczowe         String?  // JSON array tagów
  mainCategoryId        String?  // Główna kategoria wybrana podczas rejestracji
  mainCategory          Category? @relation("MainCategory", fields: [mainCategoryId], references: [id])

  // Typ działalności z formularza rejestracji (krok 1)
  expertiseCategoryId   String?
  expertiseCategory     ExpertiseCategory? @relation(fields: [expertiseCategoryId], references: [id])

  // Status biegłego sądowego — odznaka na profilu, nie osobna kategoria
  bieglySadowy          Boolean  @default(false)
  bieglySadowyNazwaSadu String?  // np. "Sąd Okręgowy w Warszawie"

  // Obszar działania
  calaPolska            Boolean  @default(false)
  onlineOnly            Boolean  @default(false)

  // Typ oferty
  typOferty             OfferType

  // System punktowy i subskrypcja
  punktySaldo           Int      @default(0)
  pakietSubskrypcji     SubscriptionPackage?
  dataPakietuOd         DateTime?
  dataPakietuDo         DateTime?
  autoRenewal           Boolean  @default(false)  // Automatyczne przedłużanie pakietu
  packageDurationDays   Int?     // Liczba dni aktywności pakietu (nadpisanie w panelu admina)

  // Statystyki
  wyswietleniaProfilu   Int      @default(0)
  zlozoneOferty         Int      @default(0)
  wygraneOferty         Int      @default(0)
  konwersja             Float    @default(0)
  pozycjaRanking        Int?

  // Zgody
  zgodaRegulamin        Boolean  @default(false)
  zgodaPrzetwarzanie    Boolean  @default(false)

  // Status konta
  zweryfikowana         Boolean  @default(false)
  aktywna               Boolean  @default(true)

  // Opiekun eksperta
  accountManagerId      String?
  accountManager        AccountManager? @relation(fields: [accountManagerId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  voivodeships          LawFirmVoivodeship[]  // Województwa działania
  counties              LawFirmCounty[]       // Powiaty działania
  cities                LawFirmCity[]         // Miasta działania
  categories            LawFirmCategory[]     // Specjalizacje
  services              Service[]
  certificates          Certificate[]
  blogPosts             BlogPost[]            @relation("AuthorBlogPosts")
  sponsoredBlogPosts    BlogPost[]            @relation("SponsoredBlogPosts")
  offers                Offer[]
  reviews               Review[]
  orders                Order[]
  invoices              Invoice[]
  promotions            Promotion[]
  favoritedBy           FavoriteLawFirm[]
  documents             Document[]
  stats                 LawFirmStats[]        // Statystyki miesięczne
  weekdayStats          LawFirmWeekdayStats[] // Statystyki wg dni tygodnia
  categoryStats         LawFirmCategoryStats[] // Statystyki wg kategorii
  partnerProgram        PartnerProgram?       // Program partnerski
  pointTransactions     PointTransaction[]    @relation("PointTransactions") // Transakcje punktowe
  consultationAvailabilities ConsultationAvailability[]
  consultationBookings       ConsultationBooking[]
  badges                     LawFirmBadge[]
  orderOverrides             OrderOverride[]
  surveyResponses            SurveyResponse[]
  contactForms               ContactForm[]         // Wiadomości z formularza na profilu eksperta

  @@index([userId])
  @@index([nip])
  @@index([zweryfikowana])
  @@index([aktywna])
  @@index([accountManagerId])
  @@index([mainCategoryId])
  @@index([expertiseCategoryId])
}

enum LawFirmType {
  OSOBA_FIZYCZNA
  SPOLKA_CYWILNA
  SPOLKA_PARTNERSKA
  SPOLKA_KOMANDYTOWA
  SPOLKA_JAWNA
  SPOLKA_ZOO
  INNY
}

enum OfferType {
  STALA_WSPOLPRACA
  JEDNORAZOWA_USLUGA
  KONSULTACJA
  WSZYSTKIE
}

enum SubscriptionPackage {
  PODSTAWOWY    // 440 zł/rok
  STANDARD      // 880 zł/rok
  PREMIUM       // 1320 zł/rok
  BIZNES        // 1980 zł/rok
}

// ============================================================================
// DANE FIRMY Z "WYKAZU PODATNIKÓW VAT" / BIAŁA LISTA (rejestracja "jako firma")
// ----------------------------------------------------------------------------
// Wszystkie pola pobierane z REST API Ministerstwa Finansów
// (https://wl-api.mf.gov.pl/api/search/nip/{nip}?date=YYYY-MM-DD) mają przedrostek
// COMPANY_. Usługa jest bezpłatna i NIE wymaga klucza. Są to NOWE, oddzielne
// pola — celowo NIE łączone z istniejącymi kolumnami (nip/regon/nazwa w LawFirm).
// Rekord jest przypisany do użytkownika (relacja 1:1 z User). Strukturę opisuje
// też plik docs/company-data-structure.txt
// ============================================================================

model CompanyData {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NIP użyty do wyszukania (parametr zapytania)
  COMPANY_searchNip String?

  // Dane podmiotu (result.subject)
  COMPANY_name             String?  // pełna nazwa / imię i nazwisko
  COMPANY_nip              String?
  COMPANY_statusVat        String?  // "Czynny" / "Zwolniony" / null
  COMPANY_regon            String?
  COMPANY_pesel            String?
  COMPANY_krs              String?
  COMPANY_residenceAddress String?  // adres siedziby / zamieszkania
  COMPANY_workingAddress   String?  // adres prowadzenia działalności

  // Daty rejestracji / odmowy / przywrócenia / wykreślenia z rejestru VAT
  COMPANY_registrationLegalDate   String?
  COMPANY_registrationDenialBasis String?
  COMPANY_registrationDenialDate  String?
  COMPANY_restorationBasis        String?
  COMPANY_restorationDate         String?
  COMPANY_removalBasis            String?
  COMPANY_removalDate             String?
  COMPANY_exemptionSmeDate        String?

  // Rachunki bankowe i flaga rachunków wirtualnych
  COMPANY_accountNumbers    String?  // JSON: ["...", "..."]
  COMPANY_hasVirtualAccounts String? // "true" / "false"

  // Reprezentanci / pełnomocnicy / wspólnicy (JSON)
  COMPANY_representatives  String?
  COMPANY_authorizedClerks String?
  COMPANY_partners         String?

  // Identyfikator i czas zapytania (potwierdzenie weryfikacji w MF)
  COMPANY_requestId       String?
  COMPANY_requestDateTime String?

  // Pełna, surowa odpowiedź (subject) z API w formacie JSON (audyt)
  COMPANY_rawResponse String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// RELACJA: KANCELARIA <-> WOJEWÓDZTWA DZIAŁANIA
// ============================================================================

model LawFirmVoivodeship {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id])

  createdAt       DateTime @default(now())

  @@unique([lawFirmId, voivodeshipId])
  @@index([lawFirmId])
  @@index([voivodeshipId])
}

// ============================================================================
// RELACJA: KANCELARIA <-> MIASTA DZIAŁANIA
// ============================================================================

model LawFirmCity {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  cityId          String
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([lawFirmId, cityId])
  @@index([lawFirmId])
  @@index([cityId])
}

// ============================================================================
// RELACJA: KANCELARIA <-> POWIATY DZIAŁANIA
// ============================================================================

model LawFirmCounty {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  countyId        String
  county          County   @relation(fields: [countyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([lawFirmId, countyId])
  @@index([lawFirmId])
  @@index([countyId])
}

// ============================================================================
// RELACJA: KLIENT <-> ULUBIONE KANCELARIE
// ============================================================================

model FavoriteLawFirm {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([clientId, lawFirmId])
  @@index([clientId])
  @@index([lawFirmId])
}

// ============================================================================
// KATEGORIE PRAWNE (SPECJALIZACJE)
// ============================================================================

enum CategoryType {
  SPRAWY_FIRMOWE   // Business cases
  SPRAWY_PRYWATNE  // Private cases
}

model Category {
  id          String   @id @default(uuid())
  nazwa       String
  slug        String   @unique
  opis        String?
  opisDodatkowy String?  // Additional description
  ikona       String?    // Icon name (e.g., from Lucide)
  ikonaUrl    String?    // Custom uploaded icon URL
  backgroundImageUrl String? // Background image URL

  // Typ kategorii
  typ         CategoryType @default(SPRAWY_PRYWATNE)

  // Hierarchia (parent/child)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  // SEO
  metaTitle       String?
  metaDescription String?

  aktywna     Boolean  @default(true)
  ekspercka   Boolean  @default(false) // Usługi ekspertów (grupowanie: Sprawy prawne / Usługi ekspertów)
  kolejnosc   Int      @default(0)
  wyswietlajNaGlownejPrywatne Boolean @default(false)
  wyswietlajNaGlownejFirmowe  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacje
  lawFirms    LawFirmCategory[]
  cases       Case[]
  caseLinks   CaseCategory[]
  stats       LawFirmCategoryStats[]
  mainCategoryFor LawFirm[] @relation("MainCategory")

  @@index([slug])
  @@index([parentId])
  @@index([aktywna])
  @@index([typ])
}

// ============================================================================
// RELACJA: KANCELARIA <-> KATEGORIE (MANY-TO-MANY)
// ============================================================================

model LawFirmCategory {
  id          String   @id @default(uuid())
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  kolejnosc   Int      @default(0)  // Order of category for this law firm
  percentage  Int      @default(0)  // Percentage knowledge of specialization (Skill Law Focus)

  createdAt   DateTime @default(now())

  @@unique([lawFirmId, categoryId])
  @@index([lawFirmId])
  @@index([categoryId])
}

// ============================================================================
// RELACJA: SPRAWA <-> KATEGORIE (MANY-TO-MANY)
// ============================================================================

model CaseCategory {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([caseId, categoryId])
  @@index([caseId])
  @@index([categoryId])
}

// ============================================================================
// SPRAWY (CASES)
// ============================================================================

model Case {
  id                        String   @id @default(uuid())
  clientId                  String
  client                    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Typ sprawy
  typSprawy                 CaseType

  // Kategoria główna (pierwsza z wybranych — zachowana dla kompatybilności)
  categoryId                String
  category                  Category @relation(fields: [categoryId], references: [id])
  // Wszystkie kategorie sprawy (many-to-many, zawiera też kategorię główną)
  categories                CaseCategory[]
  wybranadziedzinaPrawa     String?  // Podkategoria
  wybranaSpecyfikacja       String?  // Szczegółowa specyfikacja
  specjalizacja             String?  // Dodatkowe wymagania

  // Opis sprawy
  nazwaSprawy               String
  opisSprawy                String   // Min 100 znaków
  zalaczniki                String?  // JSON array URL-i (max 5 plików)

  // Termin i budżet
  oczekiwanyTerminRealizacji DateTime?
  trybPilny                 Boolean  @default(false)
  budzetOd                  Float?
  budzetDo                  Float?
  doNegocjacji              Boolean  @default(false)

  // Dane kontaktowe
  imieNazwisko              String
  telefonKontakt            String
  preferowanyKontakt        PreferredContact

  // Lokalizacja
  voivodeshipId             String
  voivodeship               Voivodeship @relation(fields: [voivodeshipId], references: [id])
  cityId                    String?
  city                      City?       @relation(fields: [cityId], references: [id])

  // Status
  status                    CaseStatus @default(NOWA)

  // Archiwizacja (soft delete)
  isArchived                Boolean  @default(false)
  archivedAt                DateTime?

  // Zgody
  akceptujeKlauzule         Boolean  @default(false)

  // Daty
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  zamknieto                 DateTime?

  // Relacje
  offers                    Offer[]
  messages                  Message[]

  @@index([clientId])
  @@index([categoryId])
  @@index([voivodeshipId])
  @@index([cityId])
  @@index([status])
  @@index([isArchived])
  @@index([createdAt])
}

enum CaseType {
  OSOBA_PRYWATNA
  FIRMA
  ORGANIZACJA
}

enum CaseStatus {
  NOWA
  OFERTY_OTRZYMANE
  W_TRAKCIE
  ZAKONCZONA
  ANULOWANA
}

enum PreferredContact {
  EMAIL
  TELEFON
  OBA
}

// ============================================================================
// OFERTY (OFFERS)
// ============================================================================

model Offer {
  id                  String   @id @default(uuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawFirmId           String
  lawFirm             LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Wycena
  kwotaNetto          Float
  vat                 Int      // 23, 8, 0, -1 (zwolniony)
  kwotaBrutto         Float

  // Termin
  terminRealizacjiDni Int      // Dni robocze

  // Opis
  opisOferty          String   // Min 200 znaków
  zakresUslug         String

  // Warunki płatności
  warunkiPlatnosci    PaymentTerms
  dodatkoweWarunki    String?

  // Wyróżnienie
  wyroznienie         Boolean  @default(false)
  punktyWyroznienia   Int?

  // Status
  status              OfferStatus @default(ZLOZONA)

  // Daty
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  zaakceptowanaData   DateTime?
  odrzuconaData       DateTime?

  // Relacje
  negotiations        Negotiation[]

  @@index([caseId])
  @@index([lawFirmId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentTerms {
  PRZELEW_7
  PRZELEW_14
  PRZELEW_30
  Z_GORY
  RATY
  INNY
}

enum OfferStatus {
  ZLOZONA
  ZAAKCEPTOWANA
  ODRZUCONA
  NEGOCJACJE
  WYGASLA
}

// ============================================================================
// NEGOCJACJE OFERT
// ============================================================================

model Negotiation {
  id                  String   @id @default(uuid())
  offerId             String
  offer               Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  propozycjaKwoty     Float
  uzasadnienie        String
  terminRealizacji    DateTime?

  createdAt           DateTime @default(now())

  @@index([offerId])
  @@index([clientId])
}

// ============================================================================
// WIADOMOŚCI
// ============================================================================

model Message {
  id            String   @id @default(uuid())
  senderId      String
  sender        User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  // Opcjonalnie powiązana ze sprawą
  caseId        String?
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  temat         String
  tresc         String
  zalaczniki    String?  // JSON array URL-i

  przeczytana   Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([caseId])
  @@index([przeczytana])
  @@index([createdAt])
}

// ============================================================================
// KONWERSACJE (MESSENGER-STYLE CHAT)
// ============================================================================

model Conversation {
  id                String   @id @default(uuid())

  // Uczestnicy konwersacji (klient i ekspert)
  clientUserId      String
  clientUser        User     @relation("ClientConversations", fields: [clientUserId], references: [id], onDelete: Cascade)

  lawFirmUserId     String
  lawFirmUser       User     @relation("LawFirmConversations", fields: [lawFirmUserId], references: [id], onDelete: Cascade)

  // Ostatnia wiadomość (denormalizacja dla wydajności)
  lastMessageText   String?
  lastMessageAt     DateTime?
  lastMessageSenderId String?

  // Archiwizacja i usuwanie (per user)
  isArchivedByClient    Boolean  @default(false)
  archivedByClientAt    DateTime?
  isArchivedByLawFirm   Boolean  @default(false)
  archivedByLawFirmAt   DateTime?

  isDeletedByClient     Boolean  @default(false)
  deletedByClientAt     DateTime?
  isDeletedByLawFirm    Boolean  @default(false)
  deletedByLawFirmAt    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relacje
  messages          ChatMessage[]
  typingIndicators  TypingIndicator[]
  documents         Document[]

  @@unique([clientUserId, lawFirmUserId])
  @@index([clientUserId])
  @@index([lawFirmUserId])
  @@index([lastMessageAt])
  @@index([isArchivedByClient])
  @@index([isArchivedByLawFirm])
  @@index([isDeletedByClient])
  @@index([isDeletedByLawFirm])
}

model ChatMessage {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId        String
  sender          User     @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content         String   // Encrypted content (AES-256-CBC)
  contentIv       String?  // Initialization vector for encryption
  attachments     String?  // JSON array URL-i (pliki PDF)

  // Status wiadomości
  status          MessageStatus @default(SENT)
  deliveredAt     DateTime?
  isRead          Boolean  @default(false)
  readAt          DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
  @@index([status])
}

enum MessageStatus {
  SENDING       // Wysyłanie (tymczasowy status)
  SENT          // Wysłano
  DELIVERED     // Dostarczono (zapisano w bazie)
  READ          // Przeczytano
  ERROR         // Błąd wysyłania
}

// ============================================================================
// BLOKOWANIE UŻYTKOWNIKÓW
// ============================================================================

model UserBlock {
  id              String   @id @default(uuid())

  blockerId       String   // Użytkownik, który blokuje
  blockedId       String   // Użytkownik zablokowany

  createdAt       DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ============================================================================
// STATUS ONLINE UŻYTKOWNIKÓW
// ============================================================================

model UserOnlineStatus {
  id              String   @id @default(uuid())
  userId          String   @unique

  isOnline        Boolean  @default(false)
  lastSeen        DateTime @default(now())

  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([isOnline])
  @@index([lastSeen])
}

// ============================================================================
// WSKAŹNIK PISANIA (TYPING INDICATOR)
// ============================================================================

model TypingIndicator {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId          String   // Użytkownik, który pisze
  isTyping        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

// ============================================================================
// OPINIE (REVIEWS)
// ============================================================================

model Review {
  id                  String   @id @default(uuid())
  lawFirmId           String
  lawFirm             LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Oceny (1-5 gwiazdek)
  ocenaOgolna         Int      // Wymagana
  profesjonalizm      Int?
  komunikacja         Int?
  terminowosc         Int?
  stosunekJakosci     Int?

  // Treść opinii
  tytulOpinii         String
  trescOpinii         String   // Min 50 znaków

  // Opcje
  polecam             Boolean  @default(true)
  anonimowa           Boolean  @default(false)

  // Odpowiedź eksperta
  odpowiedz           String?
  dataOdpowiedzi      DateTime?

  // Status
  zweryfikowana       Boolean  @default(false)
  aktywna             Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reports             ReviewReport[]

  @@index([lawFirmId])
  @@index([clientId])
  @@index([createdAt])
  @@index([aktywna])
}

// ============================================================================
// USŁUGI KANCELARII
// ============================================================================

model Service {
  id            String   @id @default(uuid())
  lawFirmId     String
  lawFirm       LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwaUslugi   String
  opisUslugi    String
  cenaOd        Float?
  cenaDo        Float?
  jednostka     ServiceUnit

  aktywna       Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lawFirmId])
  @@index([aktywna])
}

enum ServiceUnit {
  ZA_USLUGE
  ZA_GODZINE
  RYCZALT
  DO_UZGODNIENIA
}

// ============================================================================
// CERTYFIKATY KANCELARII
// ============================================================================

model Certificate {
  id                String   @id @default(uuid())
  lawFirmId         String
  lawFirm           LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwaCertyfikatu  String
  wydawca           String
  dataUzyskania     DateTime
  dataWaznosci      DateTime?
  numerCertyfikatu  String?
  skanCertyfikatu   String   // URL do pliku

  aktywny           Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([lawFirmId])
  @@index([aktywny])
}

// ============================================================================
// KATEGORIE BLOGA
// ============================================================================

model BlogCategory {
  id          String   @id @default(uuid())
  nazwa       String   @unique
  slug        String   @unique
  opis        String?

  aktywna     Boolean  @default(true)

  // Hierarchia (kategoria nadrzędna / podkategorie)
  parentId    String?
  parent      BlogCategory?  @relation("BlogCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    BlogCategory[] @relation("BlogCategoryHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacje
  blogPosts   BlogPost[]

  @@index([slug])
  @@index([aktywna])
  @@index([parentId])
}

// ============================================================================
// BLOG KANCELARII
// ============================================================================

model BlogPost {
  id                    String   @id @default(uuid())
  lawFirmId             String?
  lawFirm               LawFirm?  @relation("AuthorBlogPosts", fields: [lawFirmId], references: [id], onDelete: Cascade)
  isSponsored           Boolean   @default(false)
  sponsoredLawFirmId    String?
  sponsoredLawFirm      LawFirm?  @relation("SponsoredBlogPosts", fields: [sponsoredLawFirmId], references: [id], onDelete: SetNull)

  tytul                 String
  slug                  String   @unique
  tresc                 String

  // Kategoria bloga
  categoryId            String?
  category              BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tagi                  String?  // JSON array tagów
  obrazekWyrozniajacy   String?  // URL

  // SEO
  metaTitle             String?
  metaDescription       String?

  opublikowany          Boolean  @default(false)
  dataPublikacji        DateTime?

  wyswietlenia          Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  @@index([lawFirmId])
  @@index([sponsoredLawFirmId])
  @@index([categoryId])
  @@index([slug])
  @@index([opublikowany])
}

// ============================================================================
// ZAMÓWIENIA PUNKTÓW
// ============================================================================

model Order {
  id                String   @id @default(uuid())
  orderNumber       String?  @unique
  lawFirmId         String
  lawFirm           LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Typ zamówienia
  orderType         OrderType @default(POINTS)

  // Dla zamówień punktów
  pakietPunktow     String?   // "100_pkt", "250_pkt", etc.
  liczbaPunktow     Int?

  // Dla zamówień subskrypcji
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPeriod Int?      // 1, 6, 12 miesięcy
  packageStartDate   DateTime?
  packageEndDate     DateTime?

  // Wspólne pola
  kwota             Float
  punktyKoszt       Int?      // Koszt w punktach (dla płatności punktami)

  metodaPlatnosci   PaymentMethod
  statusPlatnosci   PaymentStatus @default(OCZEKUJE)

  // Dane rozliczeniowe
  daneFaktury       String?  // JSON z danymi do faktury

  // PayU/Przelewy24 integration
  externalOrderId   String?
  transactionId     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  zaplaconoData     DateTime?

  // Relacja z fakturą
  invoice           Invoice?

  @@index([lawFirmId])
  @@index([orderNumber])
  @@index([statusPlatnosci])
  @@index([createdAt])
  @@index([externalOrderId])
}

enum OrderType {
  POINTS        // Zakup punktów
  SUBSCRIPTION  // Zakup subskrypcji
}

enum PaymentMethod {
  PAYU
  PRZELEWY24
  PRZELEW
  PAYPAL
  BACS
  POINTS
  TEST
  TPAY
}

enum PaymentStatus {
  OCZEKUJE
  ZAPLACONE
  ANULOWANE
  ZWROT
}

// ============================================================================
// TRANSAKCJE PUNKTOWE
// ============================================================================

model PointTransaction {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation("PointTransactions", fields: [lawFirmId], references: [id], onDelete: Cascade)

  amount          Int      // Ilość punktów (dodatnia lub ujemna)
  balanceAfter    Int      // Saldo po transakcji
  type            PointTransactionType
  description     String   // Opis transakcji

  createdAt       DateTime @default(now())

  @@index([lawFirmId])
  @@index([createdAt])
  @@index([type])
}

enum PointTransactionType {
  SUBSCRIPTION_PURCHASE    // Zakup pakietu subskrypcji
  POINTS_PURCHASE          // Zakup punktów
  PROMOTION_PURCHASE       // Zakup promocji
  OFFER_HIGHLIGHT          // Wyróżnienie oferty
  PARTNER_BONUS            // Bonus partnerski
  ADMIN_ADJUSTMENT         // Korekta admina
  REFUND                   // Zwrot punktów
  SUBSCRIPTION_BONUS       // Bonus za pakiet
  REVIEW_DELETE            // Usunięcie opinii przez eksperta za punkty
  SURVEY_REWARD            // Nagroda za wypełnienie ankiety
  BUG_REPORT_REWARD        // Nagroda za zaakceptowane zgłoszenie błędu
}

// ============================================================================
// PROMOCJE
// ============================================================================

model Promotion {
  id                      String   @id @default(uuid())
  lawFirmId               String
  lawFirm                 LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  typPromocji             PromotionType
  czasTrwaniaDni          Int
  kategoriaPromocji       String?
  wojewodztwoPromocji     String?

  startPromocji           DateTime
  koniecPromocji          DateTime

  kosztPunktow            Int
  automatyczneOdnowienie  Boolean  @default(false)

  aktywna                 Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Statystyki promocji
  stats                   PromotionStats[]

  @@index([lawFirmId])
  @@index([aktywna])
  @@index([startPromocji])
  @@index([koniecPromocji])
}

enum PromotionType {
  PODBICIE_OGLOSZENIA     // 20 pkt/dobę
  WYROZNIENIE             // 50 pkt/tydzień
  TOP_LISTA               // 100 pkt/tydzień
  STRONA_GLOWNA           // 200 pkt/tydzień
  POLECANI_PRAWNICY       // 500 pkt/miesiąc
  NAJCZESCIEJ_KONSULTOWANE // 600 pkt/miesiąc
}

// ============================================================================
// KONFIGURACJA TYPÓW PROMOCJI (ZARZĄDZANE PRZEZ ADMINA)
// ============================================================================

model PromotionConfig {
  id                String   @id @default(uuid())

  // Typ promocji
  type              PromotionType @unique
  label             String
  description       String

  // Koszt
  pointsPerDay      Int?     // Dla promocji rozliczanych dziennie
  pointsPerWeek     Int?     // Dla promocji rozliczanych tygodniowo
  pointsPerMonth    Int?     // Dla promocji rozliczanych miesięcznie

  // Cechy/Features (JSON array stringów)
  features          String   // JSON: ["Feature 1", "Feature 2", ...]

  // Ikona i wygląd
  icon              String?  // Nazwa ikony lub URL
  color             String?  // Kolor tła ikony (hex)

  // Status
  aktywna           Boolean  @default(true)
  kolejnosc         Int      @default(0)  // Kolejność wyświetlania

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([aktywna])
  @@index([kolejnosc])
}

// ============================================================================
// STATYSTYKI PROMOCJI
// ============================================================================

model PromotionStats {
  id                String   @id @default(uuid())
  promotionId       String
  promotion         Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // Data dla której zbierane są statystyki (dzień)
  date              DateTime

  // Statystyki
  profileViews      Int      @default(0)  // Wyświetlenia profilu
  profileClicks     Int      @default(0)  // Kliknięcia w profil
  contactClicks     Int      @default(0)  // Kliknięcia "Kontakt"
  offersSent        Int      @default(0)  // Wysłane oferty (dla PODBICIE_OGLOSZENIA)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([promotionId, date])
  @@index([promotionId])
  @@index([date])
}

// ============================================================================
// POWIADOMIENIA
// ============================================================================

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  typ           NotificationType
  tytul         String
  tresc         String
  linkUrl       String?

  przeczytane   Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([przeczytane])
  @@index([createdAt])
}

enum NotificationType {
  NOWA_OFERTA
  NOWA_WIADOMOSC
  ZMIANA_STATUSU
  NOWA_OPINIA
  MALY_STAN_PUNKTOW
  KONIEC_SUBSKRYPCJI
  NOWA_KONSULTACJA
  KONSULTACJA_ZAAKCEPTOWANA
  KONSULTACJA_ODRZUCONA
  KONSULTACJA_ZAPLACONA
  KONSULTACJA_ANULOWANA
  SYSTEM
}

// ============================================================================
// USTAWIENIA POWIADOMIEŃ
// ============================================================================

model NotificationSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isConfigured      Boolean  @default(false)

  // Stare pola (backward compatibility)
  emailNoweOferty   Boolean  @default(true)
  emailWiadomosci   Boolean  @default(true)
  emailStatusy      Boolean  @default(true)
  smsPilne          Boolean  @default(false)

  // Powiadomienia e-mail
  kontaktKlienci              Boolean  @default(true)  // Obowiązkowe
  kluczowe                    Boolean  @default(true)  // Obowiązkowe
  wskazowkiPorady             Boolean  @default(true)
  ofertPromocje               Boolean  @default(true)
  przypomnienieWiadomosci     Boolean  @default(true)
  noweFunkcje                 Boolean  @default(true)
  zmianyCenniki               Boolean  @default(true)
  zmianyRegulamin             Boolean  @default(true)

  // Kontakt telefoniczny
  kontaktDoradca              Boolean  @default(false)

  // Dodatkowe
  wyswietlanieAwatara         Boolean  @default(true)
  autoProsbOpinie             Boolean  @default(false)
  powiadomienieDzwiekowe      Boolean  @default(false)

  // Ustawienia ogłoszenia
  ustawieniaOgloszenia        Boolean  @default(true)

  // Dodatkowe ustawienia powiadomień dla ogłoszeń
  powiadomieniaSmNowa         Boolean  @default(false)  // SMS przy nowej wiadomości
  wiadomosciZbiorcze          Boolean  @default(true)   // E-mail - wiadomości zbiorcze
  urlop                       Boolean  @default(false)  // Tryb urlopowy
  welcomePackageSeen          Boolean  @default(false)  // Czy wyświetlono modal powitalny o przyznaniu darmowego pakietu Biznes

  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// WOJEWÓDZTWA (SŁOWNIK)
// ============================================================================

model Voivodeship {
  id              String   @id @default(uuid())
  nazwa           String   @unique
  slug            String   @unique

  // Relacje
  counties        County[]
  cities          City[]
  users           User[]
  lawFirmVoivodeships LawFirmVoivodeship[]
  cases           Case[]

  @@index([slug])
}

// ============================================================================
// POWIATY (SŁOWNIK)
// ============================================================================

model County {
  id              String   @id @default(uuid())
  nazwa           String
  slug            String?
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id], onDelete: Cascade)

  // Relacje
  cities          City[]
  lawFirms        LawFirmCounty[]

  createdAt       DateTime @default(now())

  @@unique([nazwa, voivodeshipId])
  @@index([voivodeshipId])
  @@index([nazwa])
}

// ============================================================================
// MIASTA (SŁOWNIK)
// ============================================================================

model City {
  id              String   @id @default(uuid())
  nazwa           String
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id])
  // Powiat (opcjonalny - uzupełniany stopniowo)
  countyId        String?
  county          County?  @relation(fields: [countyId], references: [id], onDelete: SetNull)

  // Relacje
  lawFirms        LawFirmCity[]
  cases           Case[]
  postalCodes     PostalCode[]

  @@index([voivodeshipId])
  @@index([countyId])
  @@index([nazwa])
}

model PostalCode {
  id              String   @id @default(uuid())
  code            String
  cityId          String
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([code, cityId])
  @@index([code])
  @@index([cityId])
}

// ============================================================================
// NEWSLETTER
// ============================================================================

model Newsletter {
  id                    String    @id @default(uuid())
  email                 String    @unique
  imie                  String?
  zgoda                 Boolean   @default(true)
  aktywny               Boolean   @default(true)
  potwierdzony          Boolean   @default(false)
  tokenPotwierdzajacy   String?   @unique
  unsubscribeToken      String?   @unique
  dataPotwierdzenia     DateTime?

