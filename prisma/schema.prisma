// ============================================================================
// PAKIETY SUBSKRYPCJI
// ============================================================================

model SubscriptionPlan {
  id                    String   @id @default(uuid())

  // Podstawowe informacje
  typ                   SubscriptionPackage @unique
  nazwa                 String
  cena1Miesiac          Float?
  cena6Miesiecy         Float?
  cena12Miesiecy        Float
  aktywny               Boolean  @default(true)
  isPrimary             Boolean  @default(false)  // Oznaczenie pakietu jako podstawowego

  // Dostęp do spraw
  dostepDoSpraw         Int?     // null = nieograniczone

  // Kategorie i lokalizacje
  kategorieSpraw        Int?     // null = nieograniczone
  wojewodztwa           Int
  powiaty               Int      @default(1)
  miasta                Int

  // Funkcjonalności
  priorytetWyszukiwanie Boolean  @default(false)
  osobistyOpiekun       Int      @default(0)
  artykutySponsoro      Boolean  @default(false)
  specjalneOznaczenie   String?  // null, "Podstawowe", "Rozszerzone"
  statystykiAnalizy     Boolean  @default(false)
  mozliwoscBloga        Boolean  @default(false)
  wsparcieMarketingowe  Boolean  @default(false)
  promowanieProfilu     Boolean  @default(false)

  // Powiadomienia i komunikacja
  powiadomieniaSprawy   Int      @default(0)
  liczbaTakow           Int      @default(0)
  zalaczniki            Boolean  @default(false)
  coverBaner            Boolean  @default(false)
  wyswietlanieReklam    Boolean  @default(true)

  // Punkty gratis
  punktyGratis          Int      @default(0)

  // Skill Law Focus - specjalna funkcjonalność (dla pakietu BIZNES)
  skillLawFocus         Boolean  @default(false)

  // Obrazek pakietu
  obrazek               String?

  // Kolor pakietu (hex, np. "#3b82f6") — ustawiany w panelu admina,
  // używany do kolorowania kart i tabel pakietów
  kolor                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  orders                Order[]

  @@index([typ])
  @@index([aktywny])
}

// ============================================================================
// FAKTURY VAT
// ============================================================================

model Invoice {
  id                    String   @id @default(uuid())
  invoiceNumber         String   @unique

  // Relacje
  orderId               String   @unique
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lawFirmId             String
  lawFirm               LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Dane nabywcy (zapisane na moment wystawienia faktury)
  buyerName             String
  buyerNIP              String?
  buyerAddress          String
  buyerPostalCode       String
  buyerCity             String
  buyerCountry          String   @default("Polska")

  // Kwoty
  netAmount             Float    // Kwota netto
  vatRate               Float    @default(23.0) // Stawka VAT w %
  vatAmount             Float    // Kwota VAT
  grossAmount           Float    // Kwota brutto

  // Status i daty
  status                InvoiceStatus @default(ISSUED)
  issueDate             DateTime @default(now())
  saleDate              DateTime @default(now())
  paymentDate           DateTime?
  dueDate               DateTime

  // PDF
  pdfUrl                String?

  // KSeF integration
  ksefNumber            String?   // Unikalny numer KSeF nadany przez Ministerstwo Finansów
  ksefReferenceNumber   String?   // Numer referencyjny sesji/wysyłki KSeF
  ksefStatus            String?   // Status KSeF: PENDING, SENT, ACCEPTED, REJECTED, FAILED
  ksefDiagnostics       String?   // Diagnostyka/komunikat błędu z KSeF
  upoContent            String?   // Zawartość UPO w formacie XML/tekstowym
  ksefXml               String?   // Dokładny XML FA(3) wysłany do KSeF — jego hash SHA-256 jest częścią URL-a kodu QR

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([lawFirmId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
}

enum InvoiceStatus {
  DRAFT         // Szkic
  ISSUED        // Wystawiona
  SENT          // Wysłana
  PAID          // Opłacona
  CANCELLED     // Anulowana
}

// ============================================================================
// FORMULARZ KONTAKTOWY
// ============================================================================

model ContactForm {
  id            String   @id @default(uuid())
  imieNazwisko  String
  email         String
  telefon       String?
  temat         ContactSubject
  wiadomosc     String
  zalacznik     String?  // URL do załącznika

  zrodlo        String?  @default("KONTAKT") // KONTAKT | REKLAMA | EKSPERT
  odpowiedziano Boolean  @default(false)

  // Adresat wiadomości wysłanej z profilu eksperta (/ekspert/[slug])
  lawFirmId     String?
  lawFirm       LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())

  @@index([odpowiedziano])
  @@index([createdAt])
  @@index([zrodlo])
  @@index([lawFirmId])
}

enum ContactSubject {
  INFORMACJA
  WSPARCIE
  WSPOLPRACA
  REKLAMACJA
  INNE
}

// ============================================================================
// CENTRUM POMOCY
// ============================================================================

model HelpCategory {
  id          String   @id @default(uuid())
  nazwa       String
  slug        String   @unique
  opis        String?
  ikona       String?  // Nazwa ikony z Lucide
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)
  odbiorca    String   @default("ALL")

  // Relacje
  questions   HelpQuestion[]
}

// ============================================================================
// MODUŁY I STRONY
// ============================================================================

model Module {
  id          String     @id @default(uuid())
  name        String     // Nazwa modułu
  code        String     // Kod HTML z tagami specjalnymi jak {input-text}, {textarea-wysiwyg}, etc. lub czysty HTML dla EDITABLE_HTML
  description String?    // Opcjonalny opis modułu
  preview     String?    // URL do zdjęcia podglądu modułu
  type        ModuleType @default(TEMPLATE) // Typ modułu: TEMPLATE (z polami) lub EDITABLE_HTML (edytowalny HTML)

  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relacje
  pageModules PageModule[]

  @@index([active])
  @@index([createdAt])
  @@index([type])
}

enum ModuleType {
  TEMPLATE      // Moduł z polami edytowalnymi (stary system z {input-text}, etc.)
  EDITABLE_HTML // Moduł z edytowalnym HTML (nowy system z contenteditable)
}

model HelpQuestion {
  id          String   @id @default(uuid())
  categoryId  String
  category    HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pytanie     String
  odpowiedz   String   // Treść w markdown/HTML
  slug        String   @unique
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)

  // Statystyki
  wyswietlenia Int     @default(0)
  pomocne     Int      @default(0)
  niepomocne  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([aktywna])
  @@index([kolejnosc])
}

// ============================================================================
// STATYSTYKI KANCELARII (MIESIĘCZNE)
// ============================================================================

model LawFirmStats {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Okres statystyk
  year            Int      // Rok
  month           Int      // Miesiąc (1-12)

  // Statystyki
  profileViews    Int      @default(0)  // Wyświetlenia profilu
  offersSubmitted Int      @default(0)  // Złożone oferty
  offersAccepted  Int      @default(0)  // Zaakceptowane oferty
  offersRejected  Int      @default(0)  // Odrzucone oferty
  casesViewed     Int      @default(0)  // Obejrzane sprawy

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, year, month])
  @@index([lawFirmId])
  @@index([year, month])
}

// ============================================================================
// STATYSTYKI KANCELARII WG DNI TYGODNIA
// ============================================================================

model LawFirmWeekdayStats {
  id            String   @id @default(uuid())
  lawFirmId     String
  lawFirm       LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  dayOfWeek     Int      // 0 = Niedziela, 1 = Poniedziałek, ..., 6 = Sobota
  profileViews  Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([lawFirmId, dayOfWeek])
  @@index([lawFirmId])
}

// ============================================================================
// STATYSTYKI KANCELARII WG KATEGORII
// ============================================================================

model LawFirmCategoryStats {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Statystyki
  offersSubmitted Int      @default(0)  // Złożone oferty
  offersAccepted  Int      @default(0)  // Zaakceptowane oferty

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, categoryId])
  @@index([lawFirmId])
  @@index([categoryId])
