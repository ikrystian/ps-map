  nazwa           String
  voivodeshipId   String
  voivodeship     Voivodeship @relation(fields: [voivodeshipId], references: [id])

  // Relacje
  lawFirms        LawFirmCity[]

  @@index([voivodeshipId])
  @@index([nazwa])
}

// ============================================================================
// NEWSLETTER
// ============================================================================

model Newsletter {
  id                    String    @id @default(uuid())
  email                 String    @unique
  imie                  String?
  zgoda                 Boolean   @default(true)
  aktywny               Boolean   @default(true)
  potwierdzony          Boolean   @default(false)
  tokenPotwierdzajacy   String?   @unique
  unsubscribeToken      String?   @unique
  dataPotwierdzenia     DateTime?

  dataZapisu      DateTime  @default(now())
  dataRezygnacji  DateTime?

  @@index([email])
  @@index([aktywny])
  @@index([unsubscribeToken])
}

// ============================================================================
// PAKIETY SUBSKRYPCJI
// ============================================================================

model SubscriptionPlan {
  id                    String   @id @default(uuid())

  // Podstawowe informacje
  typ                   SubscriptionPackage @unique
  nazwa                 String
  cena1Miesiac          Float?
  cena6Miesiecy         Float?
  cena12Miesiecy        Float
  aktywny               Boolean  @default(true)

  // Dostęp do spraw
  dostepDoSpraw         Int?     // null = nieograniczone

  // Kategorie i lokalizacje
  kategorieSpraw        Int?     // null = nieograniczone
  wojewodztwa           Int
  miasta                Int

  // Funkcjonalności
  priorytetWyszukiwanie Boolean  @default(false)
  osobistyOpiekun       Int      @default(0)
  artykutySponsoro      Boolean  @default(false)
  specjalneOznaczenie   String?  // null, "Podstawowe", "Rozszerzone"
  statystykiAnalizy     Boolean  @default(false)
  mozliwoscBloga        Boolean  @default(false)
  wsparcieMarketingowe  Boolean  @default(false)
  promowanieProfilu     Boolean  @default(false)

  // Powiadomienia i komunikacja
  powiadomieniaSprawy   Int      @default(0)
  liczbaTakow           Int      @default(0)
  zalaczniki            Boolean  @default(false)
  coverBaner            Boolean  @default(false)
  wyswietlanieReklam    Boolean  @default(true)

  // Punkty gratis
  punktyGratis          Int      @default(0)

  // Skill Law Focus - specjalna funkcjonalność (dla pakietu BIZNES)
  skillLawFocus         Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  orders                Order[]

  @@index([typ])
  @@index([aktywny])
}

// ============================================================================
// FAKTURY VAT
// ============================================================================

model Invoice {
  id                    String   @id @default(uuid())
  invoiceNumber         String   @unique

  // Relacje
  orderId               String   @unique
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lawFirmId             String
  lawFirm               LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Dane nabywcy (zapisane na moment wystawienia faktury)
  buyerName             String
  buyerNIP              String?
  buyerAddress          String
  buyerPostalCode       String
  buyerCity             String
  buyerCountry          String   @default("Polska")

  // Kwoty
  netAmount             Float    // Kwota netto
  vatRate               Float    @default(23.0) // Stawka VAT w %
  vatAmount             Float    // Kwota VAT
  grossAmount           Float    // Kwota brutto

  // Status i daty
  status                InvoiceStatus @default(ISSUED)
  issueDate             DateTime @default(now())
  saleDate              DateTime @default(now())
  paymentDate           DateTime?
  dueDate               DateTime

  // PDF
  pdfUrl                String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([lawFirmId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
}

enum InvoiceStatus {
  DRAFT         // Szkic
  ISSUED        // Wystawiona
  SENT          // Wysłana
  PAID          // Opłacona
  CANCELLED     // Anulowana
}

// ============================================================================
// FORMULARZ KONTAKTOWY
// ============================================================================

model ContactForm {
  id            String   @id @default(uuid())
  imieNazwisko  String
  email         String
  telefon       String?
  temat         ContactSubject
  wiadomosc     String
  zalacznik     String?  // URL do załącznika

  odpowiedziano Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([odpowiedziano])
  @@index([createdAt])
}

enum ContactSubject {
  INFORMACJA
  WSPARCIE
  WSPOLPRACA
  REKLAMACJA
  INNE
}

// ============================================================================
// CENTRUM POMOCY
// ============================================================================

model HelpCategory {
  id          String   @id @default(uuid())
  nazwa       String
  slug        String   @unique
  opis        String?
  ikona       String?  // Nazwa ikony z Lucide
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)
  odbiorca    String   @default("ALL")

  // Relacje
  questions   HelpQuestion[]
}

// ============================================================================
// MODUŁY I STRONY
// ============================================================================

model Module {
  id          String     @id @default(uuid())
  name        String     // Nazwa modułu
  code        String     // Kod HTML z tagami specjalnymi jak {input-text}, {textarea-wysiwyg}, etc. lub czysty HTML dla EDITABLE_HTML
  description String?    // Opcjonalny opis modułu
  preview     String?    // URL do zdjęcia podglądu modułu
  type        ModuleType @default(TEMPLATE) // Typ modułu: TEMPLATE (z polami) lub EDITABLE_HTML (edytowalny HTML)

  active      Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relacje
  pageModules PageModule[]

  @@index([active])
  @@index([createdAt])
  @@index([type])
}

enum ModuleType {
  TEMPLATE      // Moduł z polami edytowalnymi (stary system z {input-text}, etc.)
  EDITABLE_HTML // Moduł z edytowalnym HTML (nowy system z contenteditable)
}

model HelpQuestion {
  id          String   @id @default(uuid())
  categoryId  String
  category    HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pytanie     String
  odpowiedz   String   // Treść w markdown/HTML
  slug        String   @unique
  kolejnosc   Int      @default(0)
  aktywna     Boolean  @default(true)

  // Statystyki
  wyswietlenia Int     @default(0)
  pomocne     Int      @default(0)
  niepomocne  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([aktywna])
  @@index([kolejnosc])
}

// ============================================================================
// STATYSTYKI KANCELARII (MIESIĘCZNE)
// ============================================================================

model LawFirmStats {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Okres statystyk
  year            Int      // Rok
  month           Int      // Miesiąc (1-12)

  // Statystyki
  profileViews    Int      @default(0)  // Wyświetlenia profilu
  offersSubmitted Int      @default(0)  // Złożone oferty
  offersAccepted  Int      @default(0)  // Zaakceptowane oferty
  offersRejected  Int      @default(0)  // Odrzucone oferty
  casesViewed     Int      @default(0)  // Obejrzane sprawy

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, year, month])
  @@index([lawFirmId])
  @@index([year, month])
}

// ============================================================================
// STATYSTYKI KANCELARII WG KATEGORII
// ============================================================================

model LawFirmCategoryStats {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Statystyki
  offersSubmitted Int      @default(0)  // Złożone oferty
  offersAccepted  Int      @default(0)  // Zaakceptowane oferty

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, categoryId])
  @@index([lawFirmId])
  @@index([categoryId])
}

// ============================================================================
// DOKUMENTY KANCELARII
// ============================================================================

model Document {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  nazwa           String
  typDokumentu    String   // np. "umowa", "regulamin", "wzór pisma", etc.
  rozmiar         Int      // Rozmiar w bajtach
  sciezka         String   // Ścieżka do pliku
  rozszerzenie    String   // np. "pdf", "docx", "txt"

  // Opcjonalne: jeśli dokument pochodzi od klienta
  zrodlo          String   @default("KANCELARIA") // "KANCELARIA" lub "KLIENT"
  clientUserId    String?  // ID klienta, który wysłał plik
  clientUser      User?    @relation("ClientDocuments", fields: [clientUserId], references: [id], onDelete: Cascade)
  conversationId  String?  // ID konwersacji, w której wysłano plik
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([createdAt])
  @@index([typDokumentu])
  @@index([zrodlo])
  @@index([clientUserId])
  @@index([conversationId])
}

model Page {
  id              String   @id @default(uuid())
  title           String   // Tytuł strony
  slug            String   @unique // URL-friendly slug

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status publikacji
  published       Boolean  @default(false)
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacje
  modules         PageModule[]

  @@index([slug])
  @@index([published])
  @@index([createdAt])
}

model PageModule {
  id        String   @id @default(uuid())

  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  order     Int      // Kolejność modułu na stronie
  data      String?  // JSON z danymi wypełnionymi przez użytkownika

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, moduleId, order])
  @@index([pageId])
  @@index([moduleId])
  @@index([order])
}

// ============================================================================
// USTAWIENIA SYSTEMU
// ============================================================================

model Settings {
  id                        String   @id @default(uuid())
  key                       String   @unique
  value                     String
  description               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// HISTORIA LOGOWAŃ
// ============================================================================

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  success     Boolean  @default(true)  // true = udane, false = nieudane
  ipAddress   String?
  userAgent   String?
  location    String?  // Opcjonalna lokalizacja (miasto, kraj)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([success])
}

// ============================================================================
// LOGI SYSTEMOWE
// ============================================================================

model SystemLog {
  id          String      @id @default(uuid())
  level       LogLevel    @default(INFO)
  action      String      // Rodzaj akcji (np. "USER_LOGIN", "ORDER_CREATED", "PAYMENT_STATUS_CHANGED")
  message     String      // Opis zdarzenia
  userId      String?     // ID użytkownika, który wykonał akcję (opcjonalne)
  metadata    String?     // Dodatkowe dane w formacie JSON
  ipAddress   String?     // Adres IP użytkownika
  userAgent   String?     // User agent przeglądarki
  createdAt   DateTime    @default(now())

  @@index([level])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

enum LogLevel {
  DEBUG       // Szczegółowe informacje diagnostyczne
  INFO        // Informacje o normalnym działaniu
  WARNING     // Ostrzeżenia, które nie są błędami
  ERROR       // Błędy, które nie zatrzymują działania systemu
  CRITICAL    // Krytyczne błędy wymagające natychmiastowej uwagi
}

// ============================================================================
// PROGRAM PARTNERSKI
// ============================================================================

model PartnerProgram {
  id                      String   @id @default(uuid())
  lawFirmId               String   @unique
  lawFirm                 LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  // Informacje o bannerze
  bannerCode              String   @unique // Unikalny kod do weryfikacji obecności bannera
  bannerPlaced            Boolean  @default(false) // Czy banner jest umieszczony
  lastVerificationDate    DateTime? // Data ostatniej weryfikacji
  lastVerificationStatus  Boolean  @default(false) // Status ostatniej weryfikacji
  verificationFailCount   Int      @default(0) // Licznik nieudanych weryfikacji

  // Status programu
  active                  Boolean  @default(true)
  monthlyPoints           Int      @default(100) // Punkty przyznawane miesięcznie

  // Daty
  joinedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relacje
  pointsHistory           PartnerPointsHistory[]

  @@index([lawFirmId])
  @@index([active])
  @@index([bannerCode])
}

model PartnerPointsHistory {
  id                    String   @id @default(uuid())
  partnerProgramId      String
  partnerProgram        PartnerProgram @relation(fields: [partnerProgramId], references: [id], onDelete: Cascade)

  // Przyznane punkty
  pointsAwarded         Int
  month                 Int      // 1-12
  year                  Int

  // Weryfikacja
  verificationUrl       String?  // URL gdzie banner został zweryfikowany
  verificationStatus    Boolean  @default(true)

  createdAt             DateTime @default(now())

  @@unique([partnerProgramId, year, month])
  @@index([partnerProgramId])
  @@index([year, month])
}

// ============================================================================
// OPIEKUNOWIE KANCELARII (ACCOUNT MANAGERS)
// ============================================================================

model AccountManager {
  id                    String   @id @default(uuid())
  imie                  String
  nazwisko              String
  email                 String   @unique
  telefon               String?
  avatar                String?  // URL do avatara
  aktywny               Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  lawFirms              LawFirm[]

  @@index([email])
  @@index([aktywny])
}

// ============================================================================
// SZABLONY EMAILI
// ============================================================================

model EmailTemplate {
  id                String   @id @default(uuid())
  nazwa             String   // Nazwa szablonu
  temat             String   // Temat emaila
  tresc             String   // Treść tekstowa emaila
  trescHtml         String?  // Treść HTML emaila
  typ               EmailType // Typ emaila
  aktywny           Boolean  @default(true) // Czy szablon jest aktywny
  triggery          String?  // JSON array triggerów (np. ["case_created"])
  zmienne           String?  // JSON array dostępnych zmiennych (np. ["{nazwaSprawi}", "{klient}"])
  opisZmiennych     String?  // JSON object z opisami zmiennych

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([typ])
  @@index([aktywny])
  @@unique([typ])
}

enum EmailType {
  NOWA_SPRAWA              // Email do kancelarii o nowej sprawie
  NOWA_OFERTA              // Email do klienta o nowej ofercie
  AKCEPTACJA_OFERTY        // Email do kancelarii o akceptacji oferty
  ODRZUCENIE_OFERTY        // Email do kancelarii o odrzuceniu oferty
  NOWA_WIADOMOSC           // Email o nowej wiadomości
  NOWA_OPINIA              // Email o nowej opinii
  REJESTRACJA_KLIENT       // Email powitalny dla klienta
  REJESTRACJA_KANCELARIA   // Email powitalny dla kancelarii
  RESET_HASLA              // Email z linkiem do resetu hasła
  POTWIERDZENIE_EMAIL      // Email z linkiem do potwierdzenia adresu email
  PLATNOSC_POTWIERDZONA    // Email o potwierdzeniu płatności
  SUBSKRYPCJA_WYGASA       // Email o wygasającej subskrypcji
  NISKI_STAN_PUNKTOW       // Email o niskim stanie punktów
  CUSTOM                   // Własny szablon
}

// ============================================================================
// KONSULTACJE
// ============================================================================

model ConsultationAvailability {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  dayOfWeek       Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime       String   // "HH:MM" format
  endTime         String   // "HH:MM" format

  price15min      Float
  price30min      Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, dayOfWeek])
  @@index([lawFirmId])
}

model ConsultationBooking {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  consultationDate DateTime
  duration         Int      // in minutes (15 or 30)
  price            Float

  topic           String
  clientContact   String

  status          ConsultationStatus @default(PENDING)
  paymentStatus   PaymentStatus      @default(OCZEKUJE)

  googleMeetUrl   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([clientId])
  @@index([status])
  @@index([consultationDate])
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// ============================================================================
// ORDERY / ODZNAKI (BADGES)
// ============================================================================

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  imageUrl    String   // URL to the badge image
  
  // Condition
  conditionType BadgeConditionType
  threshold     Int      // Value to reach (e.g., 10 cases, 1 year)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lawFirms    LawFirmBadge[]

  @@index([conditionType])
}

model LawFirmBadge {
  id        String   @id @default(uuid())
  lawFirmId String
  lawFirm   LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now())

  @@unique([lawFirmId, badgeId])
  @@index([lawFirmId])
  @@index([badgeId])
}

enum BadgeConditionType {
  YEARS_IN_SERVICE
  WON_CASES
  REVIEWS_COUNT
  BLOG_POSTS_COUNT
  OFFERS_SUBMITTED
  PROFILE_VIEWS
}
