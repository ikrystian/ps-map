  NOWA_OFERTA              // Email do klienta o nowej ofercie
  AKCEPTACJA_OFERTY        // Email do ekspercie o akceptacji oferty
  ODRZUCENIE_OFERTY        // Email do ekspercie o odrzuceniu oferty
  NOWA_WIADOMOSC           // Email o nowej wiadomości
  NOWA_OPINIA              // Email o nowej opinii
  REJESTRACJA_KLIENT       // Email powitalny dla klienta
  REJESTRACJA_KANCELARIA   // Email powitalny dla ekspertów
  RESET_HASLA              // Email z linkiem do resetu hasła
  POTWIERDZENIE_EMAIL      // Email z linkiem do potwierdzenia adresu email
  PLATNOSC_POTWIERDZONA    // Email o potwierdzeniu płatności
  SUBSKRYPCJA_WYGASA       // Email o wygasającej subskrypcji
  NISKI_STAN_PUNKTOW       // Email o niskim stanie punktów
  CUSTOM                   // Własny szablon
  POTWIERDZENIE_DODANIA_SPRAWY // Potwierdzenie dodania sprawy dla klienta
  SUBSKRYPCJA_KONIEC       // Email o wygaśnięciu subskrypcji
  PROSBA_O_OCENE           // E-mail z prośbą o ocenę prawnika
  NOWA_KONSULTACJA             // Email do eksperta o nowej prośbie o konsultację
  KONSULTACJA_ZAAKCEPTOWANA    // Email do klienta o akceptacji konsultacji
  KONSULTACJA_ZAAKCEPTOWANA_EKSPERT // Email do eksperta - potwierdzenie akceptacji
  KONSULTACJA_ODRZUCONA        // Email do klienta o odrzuceniu konsultacji
  KONSULTACJA_ZAPLACONA        // Email do klienta o potwierdzeniu płatności za konsultację
  KONSULTACJA_ANULOWANA        // Email o anulowaniu konsultacji
  PRZYPOMNIENIE_KONSULTACJI    // Email z przypomnieniem o nadchodzącej konsultacji
  LINK_KONSULTACJI             // Email z linkiem Google Meet do konsultacji
  POTWIERDZENIE_EMAIL_SUBDOMENA // Email z linkiem do potwierdzenia adresu email (subdomena)
  REJESTRACJA_SUBDOMENA_KLIENT // Email powitalny dla klienta (subdomena)
  REJESTRACJA_SUBDOMENA_KANCELARIA // Email powitalny dla ekspertów (subdomena)
  NEWSLETTER_POTWIERDZENIE     // Email z linkiem do potwierdzenia zapisu do newslettera
}

// ============================================================================
// KONSULTACJE
// ============================================================================

model ConsultationAvailability {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  dayOfWeek       Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime       String   // "HH:MM" format
  endTime         String   // "HH:MM" format

  price15min      Float
  price30min      Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([lawFirmId, dayOfWeek])
  @@index([lawFirmId])
}

model ConsultationBooking {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  consultationDate DateTime
  duration         Int      // in minutes (15 or 30)
  price            Float

  topic           String
  clientContact   String

  status          ConsultationStatus @default(PENDING)
  paymentStatus   PaymentStatus      @default(OCZEKUJE)

  googleMeetUrl   String?
  isArchived      Boolean            @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([clientId])
  @@index([status])
  @@index([consultationDate])
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// ============================================================================
// ORDERY / ODZNAKI (BADGES)
// ============================================================================

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  imageUrl    String   // URL to the badge image
  
  // Condition
  conditionType BadgeConditionType
  threshold     Int      // Value to reach (e.g., 10 cases, 1 year)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lawFirms    LawFirmBadge[]

  @@index([conditionType])
}

model LawFirmBadge {
  id        String   @id @default(uuid())
  lawFirmId String
  lawFirm   LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now())

  @@unique([lawFirmId, badgeId])
  @@index([lawFirmId])
  @@index([badgeId])
}

// ============================================================================
// LOGI EMAILI
// ============================================================================

model EmailLog {
  id              String      @id @default(uuid())
  to              String
  subject         String
  content         String?     // Treść tekstowa
  html            String?     // Treść HTML (opcjonalnie)
  templateType    String?     // Typ szablonu (jeśli dotyczy)
  variables       String?     // JSON ze zmiennymi używanymi w szablonie
  status          EmailLogStatus
  errorMessage    String?     // Komunikat o błędzie (jeśli dotyczy)
  smtpLog         String?     // Szczegółowy log z komunikacji SMTP
  sentAt          DateTime    @default(now())

  @@index([to])
  @@index([status])
  @@index([sentAt])
}

enum EmailLogStatus {
  SUCCESS
  FAILED
}

enum BadgeConditionType {
  YEARS_IN_SERVICE
  WON_CASES
  REVIEWS_COUNT
  BLOG_POSTS_COUNT
  OFFERS_SUBMITTED
  PROFILE_VIEWS
  MANUAL
}

// ============================================================================
// ZAPLANOWANE EMAILE (SCHEDULED EMAILS)
// ============================================================================

model ScheduledEmail {
  id              String               @id @default(uuid())
  to              String
  subject         String
  content         String?              // Treść tekstowa
  html            String?              // Treść HTML
  templateType    EmailType?           // Typ szablonu (opcjonalnie)
  variables       String?              // Zmienne używane w szablonie jako JSON string
  scheduledAt     DateTime             // Kiedy e-mail ma zostać wysłany
  sentAt          DateTime?            // Kiedy faktycznie został wysłany
  status          ScheduledEmailStatus @default(PENDING)
  errorMessage    String?              // Komunikat o błędzie (jeśli wysyłka nie powiodła się)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

enum ScheduledEmailStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ============================================================================
// REKLAMY
// ============================================================================

model AdClient {
  id           String          @id @default(uuid())
  name         String          // Nazwa klienta reklamowego
  contactName  String?         // Imię i nazwisko osoby kontaktowej
  contactEmail String?         // Email osoby kontaktowej
  contactPhone String?         // Telefon osoby kontaktowej
  notes        String?         // Notatki wewnętrzne
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ads          Advertisement[]

  @@index([active])
}

model Advertisement {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String?    // URL do pliku graficznego banneru
  linkUrl      String     // URL docelowy po kliknięciu
  htmlContent  String?    // Alternatywnie: niestandardowy kod HTML/skrypt (np. AdSense)
  location     String     // Miejsce wyświetlania: "search_top", "search_list_middle", "category_top", "category_sidebar"
  active       Boolean    @default(true)
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  weight       Int        @default(1)   // Waga rotacji (wyższy = częściej wyświetlana)
  priority     Int        @default(0)   // Kolejność na liście
  startDate    DateTime?  // Opcjonalna data początkowa
  endDate      DateTime?  // Opcjonalna data końcowa
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relacja do klienta reklamowego
  clientId     String?
  client       AdClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([location])
  @@index([active])
  @@index([clientId])
}

// ============================================================================
// ZGŁOSZENIA OPINII (REPORTED REVIEWS)
// ============================================================================

model ReviewReport {
  id          String   @id @default(uuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  createdAt   DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

// ============================================================================
// ZGŁOSZENIA BŁĘDÓW (EKSPERT)
// ============================================================================

model BugReport {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  opis            String
  url             String            // Adres URL strony, na której wystąpił błąd
  kategoria       BugReportCategory
  zalaczniki      String?           // JSON array URL-i zrzutów ekranu

  status          BugReportStatus   @default(NOWE)
  adminNotatka    String?           // Opcjonalny komentarz admina przy odrzuceniu
  punktyPrzyznane Boolean           @default(false) // Zabezpieczenie przed podwójną wypłatą punktów

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum BugReportCategory {
  UI_UX           // Błąd wizualny / interfejsu
  FUNKCJONALNY    // Funkcja nie działa zgodnie z oczekiwaniami
  WYDAJNOSC       // Wolne działanie / zawieszanie się
  PLATNOSCI       // Problem z płatnością
  BEZPIECZENSTWO  // Problem bezpieczeństwa
  INNE            // Inne
}

enum BugReportStatus {
  NOWE
  ZAAKCEPTOWANE
  ODRZUCONE
}

// ============================================================================
// OPINIE NA STRONIE GŁÓWNEJ (HOMEPAGE TESTIMONIALS)
// ============================================================================

model HomepageTestimonial {
  id          String   @id @default(uuid())
  name        String
  designation String
  quote       String
  src         String   // URL zdjęcia
  active      Boolean  @default(true)
  order       Int      @default(0) // do sortowania
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([order])
}

// ============================================================================
// LOGOTYPY PARTNERÓW (BELKA W PANELACH)
// ============================================================================

model PartnerLogo {
  id        String   @id @default(uuid())
  name      String   // Nazwa partnera (alt logotypu)
  imageUrl  String   // URL logotypu
  linkUrl   String?  // Adres, do którego kieruje logotyp
  active    Boolean  @default(true)
  order     Int      @default(0) // do sortowania
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

// ============================================================================
// RĘCZNE NADPISANIA POZYCJI W RANKINGU
// ============================================================================

model OrderOverride {
  id            String   @id @default(uuid())
  context       String   // "SEARCH", "HOMEPAGE_FEATURED", "HOMEPAGE_TOP", "HOMEPAGE_RECOMMENDED", "HOMEPAGE_CONSULTED"
  lawFirmId     String
  lawFirm       LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  position      Int      // Ręczna pozycja (1-indexed, np. 1 to pierwsze miejsce)
  active        Boolean  @default(true)
  notes         String?  // Notatka np. powód nadpisania ("Klient VIP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([context, lawFirmId])
  @@index([context])
}

// ============================================================================
// HARMONOGRAM ZADAŃ W TLE (SCHEDULER) — PERSYSTENCJA, LOCK, MONITORING
// ============================================================================

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Stan pojedynczego zadania cyklicznego — przetrwa restart serwera
/// oraz pełni rolę rozproszonego locka między wieloma instancjami.
model ScheduledJob {
  jobName    String        @id
  lastRunAt  DateTime?     // ostatnie zakończone uruchomienie (do nadrabiania po restarcie)
  lastStatus JobRunStatus?
  lockedAt   DateTime?     // != null => zadanie aktualnie trzyma lock
  lockedBy   String?       // identyfikator instancji trzymającej lock
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  runs       ScheduledJobRun[]

  @@index([lockedAt])
}

/// Historia uruchomień zadań — monitoring i diagnostyka niepowodzeń.
model ScheduledJobRun {
  id         String       @id @default(uuid())
  jobName    String
  job        ScheduledJob @relation(fields: [jobName], references: [jobName], onDelete: Cascade)
  status     JobRunStatus
  attempt    Int          @default(1) // numer próby (retry)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?      // komunikat błędu przy statusie FAILED
  result     String?      // serializowany JSON wyniku
  instanceId String?
  createdAt  DateTime     @default(now())

  @@index([jobName, startedAt])
  @@index([status])
}

// ============================================================================
// DRZEWO KATEGORII REJESTRACJI EKSPERTÓW (KROK 1)
// ============================================================================

model ExpertiseCategory {
  id        String   @id @default(uuid())
  nazwa     String
  parentId  String?
  parent    ExpertiseCategory?  @relation("ExpertiseCategoryTree", fields: [parentId], references: [id])
  children  ExpertiseCategory[] @relation("ExpertiseCategoryTree")
  kolejnosc Int      @default(0)
  aktywna   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lawFirms  LawFirm[]

  @@index([parentId])
  @@index([aktywna])
}

// ============================================================================
// ANKIETY
// ============================================================================

enum QuestionType {
  SINGLE    // jednokrotny wybór
  MULTIPLE  // wielokrotny wybór
}

model Survey {
  id             String   @id @default(uuid())
  tytul          String
  opis           String?
  aktywna        Boolean  @default(false)
  nagrodaPunktow Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pytania    SurveyQuestion[]
  odpowiedzi SurveyResponse[]
}

model SurveyQuestion {
  id        String       @id @default(uuid())
  surveyId  String
  survey    Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  kolejnosc Int
  tresc     String
  typ       QuestionType

  opcje      SurveyOption[]
  odpowiedzi SurveyAnswer[]

  @@index([surveyId])
}

model SurveyOption {
  id         String         @id @default(uuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kolejnosc  Int
  tresc      String

  odpowiedzi SurveyAnswer[]

  @@index([questionId])
}

model SurveyResponse {
  id        String   @id @default(uuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id])
  lawFirmId String
  lawFirm   LawFirm  @relation(fields: [lawFirmId], references: [id])
  createdAt DateTime @default(now())

  odpowiedzi SurveyAnswer[]

  @@unique([surveyId, lawFirmId])
  @@index([surveyId])
  @@index([lawFirmId])
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])
  optionId   String
  option     SurveyOption   @relation(fields: [optionId], references: [id])

  @@index([responseId])
  @@index([questionId])
}


