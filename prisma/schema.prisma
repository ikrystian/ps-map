model AccountManager {
  id                    String   @id @default(uuid())
  imie                  String
  nazwisko              String
  email                 String   @unique
  telefon               String?
  avatar                String?  // URL do avatara
  aktywny               Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relacje
  lawFirms              LawFirm[]

  @@index([email])
  @@index([aktywny])
}

// ============================================================================
// SZABLONY EMAILI
// ============================================================================

model EmailTemplate {
  id                String   @id @default(uuid())
  nazwa             String   // Nazwa szablonu
  temat             String   // Temat emaila
  tresc             String   // Treść tekstowa emaila
  trescHtml         String?  // Treść HTML emaila
  typ               EmailType // Typ emaila
  aktywny           Boolean  @default(true) // Czy szablon jest aktywny
  triggery          String?  // JSON array triggerów (np. ["case_created"])
  zmienne           String?  // JSON array dostępnych zmiennych (np. ["{nazwaSprawi}", "{klient}"])
  opisZmiennych     String?  // JSON object z opisami zmiennych

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([typ])
  @@index([aktywny])
  @@unique([typ])
