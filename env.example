# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:4000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_TRUST_HOST=true
ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@prostasprawa.pl

# Przelewy24
P24_MERCHANT_ID=your-merchant-id
P24_POS_ID=your-pos-id
P24_CRC=your-crc-key
P24_API_KEY=your-api-key
P24_SANDBOX=true
P24_API_URL=https://sandbox.przelewy24.pl
SENTRY_AUTH_TOKEN=

# Rejestracja: pozwól na pomijanie weryfikacji e-mail (flaga skipEmailVerification
# w POST /api/law-firms). Ustaw "true" TYLKO na stage/pre-rejestracji — nigdy na produkcji.
ALLOW_SKIP_EMAIL_VERIFICATION=false
