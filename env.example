# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:4000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_TRUST_HOST=true
ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@prostasprawa.pl

# Przelewy24
P24_MERCHANT_ID=your-merchant-id
P24_POS_ID=your-pos-id
P24_CRC=your-crc-key
P24_API_KEY=your-api-key
P24_SANDBOX=true
P24_API_URL=https://sandbox.przelewy24.pl
SENTRY_AUTH_TOKEN=

# SMSAPI — weryfikacja numeru telefonu kodem SMS przy rejestracji.
# UWAGA: konto prostasprawa.pl działa na platformie smsapi.COM (nie .pl) —
# token z panelu .com zwraca "authorization_failed" na api.smsapi.pl.
#
# Tryb wysyłki i token ustawia się w panelu administratora (Ustawienia → SMS).
# Poniższe zmienne to fallback, gdy w panelu nic nie ustawiono.
SMSAPI_TOKEN=
SMSAPI_API_URL=https://api.smsapi.com
# Nazwa nadawcy musi być zweryfikowana w panelu SMSAPI (maks. 11 znaków).
# Konta trial mają dostępną wyłącznie nazwę "Test".
SMSAPI_SENDER=Test
# Wymusza symulację w trybie "auto" poza produkcją: SMS nie jest wysyłany,
# kod trafia do logów serwera i do okienka weryfikacji na stronie.
# Bez ustawionego SMSAPI_TOKEN symulacja włącza się automatycznie poza produkcją.
# Ignorowane, gdy w panelu wybrano tryb SYMULACJA albo PRODUKCJA.
SMSAPI_SIMULATE=false

# Rejestracja: pozwól na pomijanie weryfikacji e-mail (flaga skipEmailVerification
# w POST /api/law-firms). Ustaw "true" TYLKO na stage/pre-rejestracji — nigdy na produkcji.
ALLOW_SKIP_EMAIL_VERIFICATION=false
